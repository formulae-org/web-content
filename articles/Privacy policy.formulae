<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.internet">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Privacy policy"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Your privacy is important to us. It is Fōrmulæ's policy to respect your privacy regarding any information we may collect from you across our website, https://formulae.org, and other sites we own and operate."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="We only ask for personal information when we truly need it to provide a service to you. We collect it by fair and lawful means, with your knowledge and consent. We also let you know why we’re collecting it and how it will be used."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="We only retain collected information for as long as necessary to provide you with your requested service. What data we store, we’ll protect within commercially acceptable means to prevent loss and theft, as well as unauthorized access, disclosure, copying, use or modification."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="We don’t share any personally identifying information publicly or with third-parties, except when required to by law."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Our website may link to external sites that are not operated by us. Please be aware that we have no control over the content and practices of these sites, and cannot accept responsibility or liability for their respective privacy policies."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="You are free to refuse our request for your personal information, with the understanding that we may be unable to provide you with some of your desired services."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Web Analytics"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="We have integrated the component Google Analytics (with anonymisation function) on this website."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Google Analytics is a web analytics service. Web analysis is the gathering, collection and analysis of data about the behavior of visitors to websites. Among other things, a web analysis service collects data on which website a data subject has come to a website from (so-called referrers), which subpages of the website were accessed or how often and for which period of time a subpage was viewed. A web analysis is mainly used to optimize a website and for the cost-benefit analysis of Internet advertising."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The operator of the Google Analytics component is Google Inc., 1600 Amphitheatre Pkwy, Mountain View, CA 94043-1351, USA."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Google Analytics uses cookies. The information generated by the cookie about your use of this website is usually transmitted to a Google server in the USA and stored there. Google might transfer the personal information collected via this technical procedure to third parties."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As IP anonymization is activated on our website, your IP address will be shortened by Google within Member States of the European Union or other states in agreement with the European Economic Area. Only in exceptional cases, the full IP address is sent to and shortened by a Google server in the USA. On behalf of the operator of the website, Google will use this information to evaluate your use of the website, compile reports on website activity and to provide further services related to website and internet use to us. The IP address transferred through your browser to Google Analytics will not be combined with other data held by Google."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In addition, this website uses the Analytics feature UserID to track interaction data. This User ID will be additionally anonymized and encrypted and will not be linked with other data."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="You can prevent the storage of cookies by a corresponding setting of your browser software; however, please note that if you do this, you may not be able to use all the features of this website to the fullest extent possible."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In addition, you may prevent the collection of the data generated by the cookie and related to your use of the website (including your IP address) by Google as well as the processing of this data by Google by downloading and installing the browser plug-in available under the following link:"/>
				<expression tag="Internet.Hyperlink" Value="https://tools.google.com/dlpage/gaoptout?hl=en" Description="https://tools.google.com/dlpage/gaoptout?hl=en."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This browser add-on informs Google Analytics via JavaScript that no data and information about website visits may be transmitted to Google Analytics."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In addition, a cookie already set by Google Analytics can be deleted at any time via the Internet browser or other software programs."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Further information and Google's applicable privacy regulations can be found at"/>
				<expression tag="Internet.Hyperlink" Value="https://marketingplatform.google.com/about/" Description="https://marketingplatform.google.com/about/."/>
				<expression tag="String.Text" Value="The following link provides a further explanation of Google Analytics"/>
				<expression tag="Internet.Hyperlink" Value="https://adssettings.google.com/" Description="https://adssettings.google.com/."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Our website also uses Google Analytics performance reports relating to demographics and interests and reports on Google Display Network impressions. You can disable Google Analytics for display advertising and customize the ads on the Google Display Network by visiting the ad settings at this link:"/>
				<expression tag="Internet.Hyperlink" Value="https://adssettings.google.com/" Description="https://adssettings.google.com/."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="AI conversations (Converse)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Fōrmulæ can send an expression to an artificial intelligence (AI) model and show the model's answer. This is called Converse mode. You can set up your own connection to an AI provider. If you have not set one up, Fōrmulæ uses a free built-in demo connection, described below."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="When you use Converse without a connection of your own, the expression you send is passed to the Gemini API, operated by Google LLC, through Google's Firebase AI Logic service. This includes any text, formulas, images or audio in the expression, together with the instructions Fōrmulæ adds to every request. Google processes it to produce the answer, which is returned to your browser."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The demo connection uses Google's free (unpaid) Gemini API service. Under Google's terms, Google may use the content you send, and the answers it produces, to provide, improve and develop its products and machine-learning technologies. Human reviewers may read and annotate this content, after Google has separated it from the account it was sent with."/>
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Do not include sensitive, confidential or personal information in prompts sent through the demo connection."/>
				</expression>
				<expression tag="String.Text" Value="Google's terms for the Gemini API:"/>
				<expression tag="Internet.Hyperlink" Value="https://ai.google.dev/gemini-api/terms" Description="https://ai.google.dev/gemini-api/terms."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The demo connection may only be used by people who are 18 years of age or older, and is not available in the European Economic Area, Switzerland or the United Kingdom. Fōrmulæ detects the region from your browser's time zone, and asks you to confirm your age the first time you use the demo. Your confirmation is remembered in your browser's local storage; it is not sent to Fōrmulæ or to Google."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Fōrmulæ does not store your prompts or the answers on its own servers. They stay in your browser, as part of the script you are working on."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="To protect the demo connection from abuse, Fōrmulæ uses Firebase App Check with Google Cloud Fraud Defense (formerly reCAPTCHA Enterprise). It is loaded only when the demo connection is first used. It collects information about your device and browser and sends it to Google, to check that requests come from the Fōrmulæ website. Google's Privacy Policy"/>
				<expression tag="Internet.Hyperlink" Value="https://policies.google.com/privacy" Description="https://policies.google.com/privacy"/>
				<expression tag="String.Text" Value="and Terms of Service"/>
				<expression tag="Internet.Hyperlink" Value="https://policies.google.com/terms" Description="https://policies.google.com/terms"/>
				<expression tag="String.Text" Value="apply."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Your continued use of our website will be regarded as acceptance of our practices around privacy and personal information. If you have any questions about how we handle user data and personal information, feel free to contact us."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This policy was last updated on November 2nd, 2026."/>
			</expression>
		</expression>
	</expression>
</expression>