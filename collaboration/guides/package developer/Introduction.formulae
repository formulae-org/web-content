<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.internet,org.formulae.math.arithmetic,org.formulae.symbolic,org.formulae.diagramming,org.formulae.programming,org.formulae.logic,org.formulae.relation,org.formulae.list,org.formulae.visualization,org.formulae.color,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Introduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Fōrmulæ is a software"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/Framework" Description="framework"/>
				<expression tag="String.Text" Value="for the definition, manipulation, visualization, editing and transformation of expressions of all kinds, for example mathematical ones."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As a framework, it is a set of concepts and rules, plus an"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/API" Description="API"/>
				<expression tag="String.Text" Value="to support the work of programming within that framework."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Concepts"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="An expression is a representation of an entity from the real world. They need not be material objects; they can be ideas, mathematical abstractions, programming structures, etc."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are expressions that are defined in terms of other expressions (or that contain other expressions)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This allows the creation of complex mathematical expressions, or of any kind, for example the expression"/>
				<expression tag="Math.Arithmetic.Division">
					<expression tag="Math.Arithmetic.Addition">
						<expression tag="Math.Arithmetic.Negative">
							<expression tag="Symbolic.Symbol" Name="b"/>
						</expression>
						<expression tag="Math.Arithmetic.SquareRoot">
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Math.Arithmetic.Exponentiation">
									<expression tag="Symbolic.Symbol" Name="b"/>
									<expression tag="Math.Number" Value="2"/>
								</expression>
								<expression tag="Math.Arithmetic.Negative">
									<expression tag="Math.Arithmetic.Multiplication">
										<expression tag="Math.Number" Value="4"/>
										<expression tag="Symbolic.Symbol" Name="a"/>
										<expression tag="Symbolic.Symbol" Name="c"/>
									</expression>
								</expression>
							</expression>
						</expression>
					</expression>
					<expression tag="Math.Arithmetic.Multiplication">
						<expression tag="Math.Number" Value="2"/>
						<expression tag="Symbolic.Symbol" Name="a"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="is represented as:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Division"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="Addition"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Negative"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Symbolic.Symbol" Name="b"/>
							</expression>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Square root"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="String.Text" Value="Addition"/>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="String.Text" Value="Exponentiation"/>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="Symbolic.Symbol" Name="b"/>
									</expression>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="Math.Number" Value="2"/>
									</expression>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="String.Text" Value="Negative"/>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="String.Text" Value="Multiplication"/>
										<expression tag="Diagramming.Tree" Expanded="True">
											<expression tag="Math.Number" Value="4"/>
										</expression>
										<expression tag="Diagramming.Tree" Expanded="True">
											<expression tag="Symbolic.Symbol" Name="a"/>
										</expression>
										<expression tag="Diagramming.Tree" Expanded="True">
											<expression tag="Symbolic.Symbol" Name="c"/>
										</expression>
									</expression>
								</expression>
							</expression>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="Multiplication"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Math.Number" Value="2"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Symbolic.Symbol" Name="a"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This representation is commonly known as an &quot;inverted tree&quot; and is widely used by programmers, since it shows how expressions interconnect with their subexpressions using the mechanisms native to a programming language (pointers, references, etc.)"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Root expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Within an expression, the root expression is the one located at the very top of the expression once it is represented as an inverted tree. More formally, it is the only expression that has no parent expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In the example expression, the division expression is the root expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Terminal expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A terminal expression is one that has no subexpressions. In the example, the number expressions are all terminal expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Expression management"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following are the &quot;operations&quot; that can be performed on expressions, with the help of the framework:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Defining expressions."/>
					</expression>
					<expression tag="String.Text" Value="It is the generation of attributes common to all expressions, such as an identifier, the number of subexpressions it can have, etc."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Visualizing expressions."/>
					</expression>
					<expression tag="String.Text" Value="While representing expressions as inverted trees has many advantages from a programming point of view, for the end user it is much better to represent expressions in a more natural form, in the way humans are used to representing them, for example when we draw them on paper. This includes mathematical notation, but also other notations, for example representing programs as flowcharts or as indented code, etc."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Editing expressions."/>
					</expression>
					<expression tag="String.Text" Value="In the same way as for visualization, expressions need to be edited in a natural and comfortable way."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Reducing expressions."/>
					</expression>
					<expression tag="String.Text" Value="Reduction is the transformation of expressions into others, not necessarily simpler or smaller, but more informative or more useful. Any mathematical calculation, and even the computation of programs, can be carried out in terms of expression reduction."/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Packages"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Most programming languages or applications are monolithic, which means that the whole program or application comes from a well-defined set of source programs. Of course, that code may be developed by several people; however, its scope and functionality are delimited in advance, so the system or language will not have capabilities beyond those previously specified."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The Fōrmulæ framework allows the programming of expression operations (definition, visualization, editing and reduction) to be carried out in independent units called"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="packages."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Packages are typically created by field of science; for example, there is a package for arithmetic, another for handling character strings, another for programming, etc."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Applications that make use of the framework must be able to dynamically load the packages the user requires, depending on the fields of science they need or based on their personal preferences."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="See the following example:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Programming.While">
					<expression tag="Logic.True"/>
					<expression tag="Programming.Block" Description="Description" Expanded="True">
						<expression tag="Symbolic.Assignment">
							<expression tag="Symbolic.Symbol" Name="x"/>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Math.Arithmetic.Division">
									<expression tag="Symbolic.Symbol" Name="x"/>
									<expression tag="Math.Number" Value="2"/>
								</expression>
								<expression tag="Math.Number" Value="1"/>
							</expression>
						</expression>
						<expression tag="Programming.If">
							<expression tag="Relation.Different">
								<expression tag="Symbolic.Symbol" Name="x"/>
								<expression tag="Math.Number" Value="128"/>
							</expression>
							<expression tag="Symbolic.Return">
								<expression tag="Math.Arithmetic.Summation">
									<expression tag="Math.Arithmetic.Exponentiation">
										<expression tag="Symbolic.Symbol" Name="n"/>
										<expression tag="Math.Number" Value="2"/>
									</expression>
									<expression tag="Symbolic.Symbol" Name="n"/>
									<expression tag="Math.Number" Value="1"/>
									<expression tag="Symbolic.Symbol" Name="x"/>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Even though the expression contains the visualization of different packages (programming, logic, arithmetic, relational operations), which were developed independently of one another, the program used to display the complete expression is able to dynamically load those packages and make the expressions it contains interoperate with one another in a natural and consistent way."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Applications"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Fōrmulæ is not only a final product, but also a framework with which several applications can be created, depending on which operations they use."/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Definition"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Visualization"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Reduction"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Resulting product"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="String.Text" Value="Document viewer"/>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="String.Text" Value="Document editor"/>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Visualization.VerticalArray">
								<expression tag="String.Text" Value="Programming environment"/>
								<expression tag="String.Text" Value="Expressions can be visualized, edited and executed"/>
								<expression tag="String.Text" Value="It is the application you are using now"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="Library for evaluating mathematical formulas"/>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="✓"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Color.Color" Red="0" Green="0" Blue="0" Alpha="0"/>
							<expression tag="String.Text" Value="✓"/>
							<expression tag="Visualization.VerticalArray">
								<expression tag="String.Text" Value="Interactive document viewer"/>
								<expression tag="String.Text" Value="The expressions or programs it contains can be executed"/>
								<expression tag="String.Text" Value="but they cannot be modified"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Of all those possibilities, one has been created, the one that uses all the expression operations, which is the web application you are using now."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Programming language"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Several packages have already been created to carry out various operations in their fields of science; you can see the list"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/orgs/formulae-org/repositories" Description="here."/>
				<expression tag="String.Text" Value="One of them concerns programming (imperative, structured), which allows a programming language to emerge, named"/>
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ."/>
				</expression>
				<expression tag="String.Text" Value="It can be shown that this language is"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/Turing_completo" Description="Turing complete,"/>
				<expression tag="String.Text" Value="which means it is capable of computing everything that is computable."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If you build a package for some field of science (for example, statistics), you too are contributing to the growth of a programming language; you are taking part in its growth, and therefore you are becoming part of this language."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In addition to the above, it is possible to create packages that contribute to the basic capabilities of the language; modules can be created that add"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/Paradigma_de_programaci%C3%B3n" Description="programming paradigms"/>
				<expression tag="String.Text" Value="to the language itself, for example, adding object-oriented programming capabilities, logic programming, etc."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Formatted documents"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org/package-typesetting-js" Description="typesetting"/>
				<expression tag="String.Text" Value="package allows the creation of formatted expressions, such as creating paragraphs, text styles (bold, italic, colored, etc.), aligned text, bullets, image inclusion, etc., which enables the creation of formatted documents."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This allows scripts (files that contain the expressions you create and their results), as well as your programs, to be combined with formatted text, allowing them to be documented and explained."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The document you are reading now is an example of a formatted document."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781784000000"/>
			</expression>
		</expression>
	</expression>
</expression>