<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.list,org.formulae.visualization,org.formulae.time,org.formulae.internet">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Internationalization"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Until now, in the examples shown, when a string representing a description had to be specified, we have used literal strings, that is, placing the literal directly in the code."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="However, if we want our programs to be viewable in other regions of the world, the use of localized strings will be required, that is, that the strings be obtained according to the region where the program is being used."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Language codes"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/ISO_639-1" Description="ISO 639-1"/>
				<expression tag="String.Text" Value="standard defines a set of two-character codes (always lowercase) for associating languages. Some examples are:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Language"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Code"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="English"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="en"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Spanish"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="es"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Italian"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="it"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Country codes"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/ISO_3166-1_alfa-2" Description="ISO 3166-1 alpha-2"/>
				<expression tag="String.Text" Value="standard defines a set of two-character codes (always uppercase) for associating countries. Some examples are:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Country"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Code"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Mexico"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="MX"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Spain"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="ES"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Switzerland"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="CH"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Locale codes"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A locale is a region that shares the same set of entities, such as the language, the currency, etc."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It is common for locales to be defined in the form"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ii-PP"/>
				</expression>
				<expression tag="String.Text" Value="where"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ii"/>
				</expression>
				<expression tag="String.Text" Value="is the language code and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="PP"/>
				</expression>
				<expression tag="String.Text" Value="is the country code, for example"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Locale"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Code"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Spanish (Mexico)"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="es-MX"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="Spanish (Spain)"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="es-ES"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="French (France)"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="fr-FR"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="French (Canada)"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="fr-CA"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Although there are locales that seem to be equivalent, there are always regional differences; for example, in the locale"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="es-MX"/>
				</expression>
				<expression tag="String.Text" Value="the number 1,234.56"/>
				<expression tag="String.Text" Value=", in the locale"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="es-ES"/>
				</expression>
				<expression tag="String.Text" Value="must be represented as 1.234,56"/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Message files"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Each package has an associated directory called"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="i18n"/>
				</expression>
				<expression tag="String.Text" Value="which is where the message files are stored."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There is one message file for each"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="locale,"/>
				</expression>
				<expression tag="String.Text" Value="that is, for each region. These files are of the JSON type."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="These files can have the following naming conventions:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages.json"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages_&lt;ii&gt;.json"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages_&lt;ii&gt;-&lt;PP&gt;.json"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Where"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ii"/>
				</expression>
				<expression tag="String.Text" Value="is a language code and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="PP"/>
				</expression>
				<expression tag="String.Text" Value="is a country code."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages.json"/>
				</expression>
				<expression tag="String.Text" Value="file must always exist; it contains the default messages. This default value always refers to the English language in the United States of America."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Selecting the message file"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Given a locale"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ii-PP"/>
				</expression>
				<expression tag="String.Text" Value="(the browser's locale), the framework selects the file as follows:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="If the file"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="messages_&lt;ii&gt;-&lt;PP&gt;.json"/>
					</expression>
					<expression tag="String.Text" Value="exists, then that is the one it selects."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Otherwise, if the file"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="messages_&lt;ii&gt;.json"/>
					</expression>
					<expression tag="String.Text" Value="exists, then that is the one it selects."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Otherwise, it selects the file"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="messages.json"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For example, if the locale is"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="pt-BR"/>
				</expression>
				<expression tag="String.Text" Value="(Portuguese in Brazil), the framework will look for the message file in the following order: the file"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages_pt-BR.json"/>
				</expression>
				<expression tag="String.Text" Value=", the file"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages_pt.json"/>
				</expression>
				<expression tag="String.Text" Value="and finally the file"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages.json"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Structure of the message files"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Being a JSON-format file, it consists of a series of label-value pairs, where the label is a text string and the value can be of several types, although, for internationalization purposes, it is typically a string."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="All the message files that reside in the same"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="i18n"/>
				</expression>
				<expression tag="String.Text" Value="directory, and therefore belong to the same package, must contain the same labels; what varies are their values, which are the appropriate ones for the language or locale."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following are two hypothetical files for an arithmetic package:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="messages.json"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;&quot;addition&quot;       : &quot;Addition&quot;,&#10;&#9;&quot;multiplication&quot; : &quot;Multiplication&quot;,&#10;&#9;&quot;division&quot;       : &quot;Division&quot;,&#10;&#9;&quot;exponentiation&quot; : &quot;Exponentiation&quot;&#10;}"/>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="messages_es.json"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;&quot;addition&quot;       : &quot;Suma&quot;,&#10;&#9;&quot;multiplication&quot; : &quot;Multiplicación&quot;,&#10;&#9;&quot;division&quot;       : &quot;División&quot;,&#10;&#9;&quot;exponentiation&quot; : &quot;Exponenciación&quot;&#10;}"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following are three hypothetical files for a file-management package:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="messages.json"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;:&#10;&#9;&quot;file&quot; : &quot;File&quot;,&#10;&#9;:&#10;}"/>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="messages_es.json"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;:&#10;&#9;&quot;file&quot; : &quot;Archivo&quot;,&#10;&#9;:&#10;}"/>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="messages_es-ES.json"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;:&#10;&#9;&quot;file&quot; : &quot;Fichero&quot;,&#10;&#9;:&#10;}"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Using messages in code"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Once the framework determines the message file to be used, it associates the content of this file as the"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="messages"/>
				</expression>
				<expression tag="String.Text" Value="property to each of the classes used for the definition, visualization, editing, and reduction of expressions, so it is directly and immediately usable by those classes."/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="export class ArithmeticPackage extends Formulae.ExpressionPackage {};&#10;&#10;const Addition = class extends ... {&#10;&#9;:&#10;&#9;getName() { return ArithmeticPackage.messages.addition; }&#10;&#9;:&#10;};"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781784000000"/>
			</expression>
		</expression>
	</expression>
</expression>