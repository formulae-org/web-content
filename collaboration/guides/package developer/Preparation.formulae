<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.diagramming,org.formulae.visualization,org.formulae.internet,org.formulae.logic,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Preparation"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Before you start collaborating, you will need a copy of the project on your machine. In this section you will learn how it is structured."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="General structure"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="You need to create a specific directory for the project. The name does not matter. The following structure must exist under this directory:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="root"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="formulae"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="lib"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="packages"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="org.formulae.math.arithmetic"/>
							</expression>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="org.formulae.logic"/>
							</expression>
						</expression>
						<expression tag="Visualization.HorizontalEllipsis"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Italic" Value="True" Set="True">
								<expression tag="String.Text" Value="your package"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="content"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following files must be found in the root directory:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="index.html"/>
					</expression>
					<expression tag="String.Text" Value="file that contains the main page."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="formulae.css"/>
					</expression>
					<expression tag="String.Text" Value="file that contains the basic styles."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="formulae"/>
				</expression>
				<expression tag="String.Text" Value="directory contains the base code. It contains the following:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The base classes"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The code of the"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="front-end"/>
					</expression>
					<expression tag="String.Text" Value="as a"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="web application"/>
					</expression>
					<expression tag="String.Text" Value="that is, the program that allows the visualization and editing of expressions in a web browser."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The code of the reduction engine"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If you are a programmer who is going to create packages, the code in this directory is not something you will modify, but it does need to exist so that you can do your work."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="lib"/>
				</expression>
				<expression tag="String.Text" Value="directory contains libraries that can be used by the base code or packages. For now, only the"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/MikeMcl/decimal.js" Description="decimal.js"/>
				<expression tag="String.Text" Value="library is used."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages"/>
				</expression>
				<expression tag="String.Text" Value="directory. Recall that in Fōrmulæ functionality is modular, since it is created in units called"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="packages."/>
				</expression>
				<expression tag="String.Text" Value="Each package resides in its own subdirectory. It is important to make a list of the packages you will really need; there is no point downloading code you will never use or have no interest in testing. In this directory you will create a subdirectory for your package."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="content"/>
				</expression>
				<expression tag="String.Text" Value="directory contains files of type"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value=".formulae"/>
				</expression>
				<expression tag="String.Text" Value="that is, created with Fōrmulæ, and they contain the documentation base, made up mainly of examples, reference material, tutorials, articles and development guides. The file you are viewing belongs to this last category. If you are a programmer who is going to create packages, it is not mandatory for you to have all the content; after all, if you wanted to access it (for example, to see the references or user guides) you can access it through the website, just as you do with this page."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Repositories"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The repository for the base code"/>
				<expression tag="String.Text" Value="is on GitHub as"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org/formulae-js" Description="formulae-js"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/MikeMcl/decimal.js" Description="decimal.js"/>
				<expression tag="String.Text" Value="library can be downloaded"/>
				<expression tag="Internet.Hyperlink" Value="lib/decimal.min.js" Description="here."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Each package has its own repository on"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org#the-packages" Description="GitHub"/>
				<expression tag="String.Text" Value="It is not necessary to create all the package directories, although some are strictly indispensable, for example the arithmetic one. The final list you use depends greatly on the packages you wish to contribute to."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The repository for the content is at"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org/web-content" Description="web-content"/>
				<expression tag="String.Text" Value="however, it is not strictly necessary for you to clone it, unless you are also going to take part in editing content."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Structure of a package"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Each package, and therefore the package you are going to create, has a structure like the following:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="package"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="expression.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="edition.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="reduction.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="i18n"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages.json"/>
							</expression>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages_es.json"/>
							</expression>
						</expression>
						<expression tag="String.Text" Value="..."/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages_it.json"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.HorizontalArray">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="img"/>
							</expression>
							<expression tag="String.Text" Value="(optional)"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="expression.js"/>
				</expression>
				<expression tag="String.Text" Value="file contains the code related to the definition and visualization of expressions; see the sections on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Expressions" Description="definition"/>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Visualization" Description="visualization"/>
				<expression tag="String.Text" Value="of expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="edition.js"/>
				</expression>
				<expression tag="String.Text" Value="file contains the code related to the editing of expressions; see the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Edition" Description="editing of expressions"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="reduction.js"/>
				</expression>
				<expression tag="String.Text" Value="file contains the code related to the transformation or reduction of expressions; see the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Reduction" Description="reduction of expressions"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="i18n"/>
				</expression>
				<expression tag="String.Text" Value="directory relates to internationalization (commonly shortened to"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="i18n),"/>
				</expression>
				<expression tag="String.Text" Value="see the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Internationalization" Description="internationalization"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="img"/>
				</expression>
				<expression tag="String.Text" Value="directory is optional; it is used to hold the images required by the module, basically icons; see the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Edition" Description="editing of expressions"/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Defining the packages to load, including your own"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In the root directory there is the"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages.json"/>
				</expression>
				<expression tag="String.Text" Value="file, which contains an array called"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages"/>
				</expression>
				<expression tag="String.Text" Value="where each element describes a package known to the system. For example:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{ &quot;name&quot;: &quot;org.formulae.math.arithmetic&quot;, &quot;description&quot;: &quot;Arithmetic&quot;,            &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.algebra&quot;,         &quot;description&quot;: &quot;Algebra&quot;,               &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.math.complex&quot;,    &quot;description&quot;: &quot;Complex&quot;,               &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.relation&quot;,        &quot;description&quot;: &quot;Relation&quot;,              &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.logic&quot;,           &quot;description&quot;: &quot;Logic&quot;,                 &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.expression&quot;,      &quot;description&quot;: &quot;Expression management&quot;, &quot;required&quot;: true,  &quot;commonRequired&quot;: false }"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Each object has the following fields:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="name"/>
					</expression>
					<expression tag="String.Text" Value="the name of the package directory."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="description"/>
					</expression>
					<expression tag="String.Text" Value="a descriptive name for the package."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="required"/>
					</expression>
					<expression tag="String.Text" Value="a boolean value indicating whether the package should be loaded automatically. It is recommended to use the value"/>
					<expression tag="Logic.True"/>
					<expression tag="String.Text" Value="so that you do not have to reload it every time you make changes to the code."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="commonRequired"/>
					</expression>
					<expression tag="String.Text" Value="a boolean value indicating whether the classes that make up the package should have a common class. For your package, it is better to start by using a value of"/>
					<expression tag="Logic.False"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="From the complete list of packages, for those that are not of interest to you, you can change their"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="required"/>
				</expression>
				<expression tag="String.Text" Value="field to the value"/>
				<expression tag="Logic.False"/>
				<expression tag="String.Text" Value="so that the framework does not load them automatically."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For the package you are going to create, simply add a new object with its information to the array."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Execution"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The project is not run simply by opening the"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="index.html"/>
				</expression>
				<expression tag="String.Text" Value="page, since there is functionality that requires the project to run on a real web server, even if only locally."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For this reason, you need to use one. No particular one is required; some of the following are suggested:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="With"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Node.js"/>
						</expression>
						<expression tag="String.Text" Value="use the package"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="http-server"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Install the package, then go to the root directory and run:"/>
					</expression>
					<expression tag="Visualization.CodeBlock" Value="http-server"/>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The default port is 8080"/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="With"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Python,"/>
						</expression>
						<expression tag="String.Text" Value="use the module"/>
						<expression tag="Internet.Hyperlink" Value="https://docs.python.org/3.13/library/http.server.html" Description="http.server"/>
						<expression tag="String.Text" Value="which comes preinstalled."/>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="To start the web server, go to the root directory and run:"/>
					</expression>
					<expression tag="Visualization.CodeBlock" Value="python3 -m http.server [port]"/>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The default port is 8000"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Once the web server is running, to open the Fōrmulæ system, use the following URL in a tab of your browser:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="localhost:&lt;port&gt;"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The web server will respond with the content of the file"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="index.html"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781870400000"/>
			</expression>
		</expression>
	</expression>
</expression>