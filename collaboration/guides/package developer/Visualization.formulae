<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.graphics.raster,org.formulae.visualization,org.formulae.internet,org.formulae.math.arithmetic,org.formulae.diagramming,org.formulae.symbolic,org.formulae.expression,org.formulae.list,org.formulae.math.complex,org.formulae.relation,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Visualization"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Every expression class must have a visualization form, which is the representation of the expression in a two-dimensional environment."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Metrics"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Every expression has some metrics, based on the following figure:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Graphics.RasterGraphics" Value="" Format="image/png"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As in most graphical environments, the coordinate system is such that the abscissas (x) increase to the right and the ordinates (y) increase downward."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="These metrics are:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A size, defined by width and height values."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A position, defined by a coordinate pair (x, y), relative to the origin of the parent expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="An imaginary horizontal line, called the"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="horizontal baseline"/>
					</expression>
					<expression tag="String.Text" Value="used for alignment purposes. Analogously, there is a"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="vertical baseline."/>
					</expression>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Attributes and methods"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="These metrics are defined in the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value="by means of the following attributes and methods:"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Attributes:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="width"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the width of the expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="height"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the height of the expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="horzBaseline"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the vertical distance of the horizontal baseline relative to the origin of the expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="vertBaseline"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the horizontal distance of the vertical baseline relative to the origin of the expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="x"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the horizontal component of the expression's position, relative to the origin of its parent expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="y"/>
					</expression>
					<expression tag="String.Text" Value="attribute, which is the vertical component of the expression's position, relative to the origin of its parent expression."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="All the attributes are of type"/>
				<expression tag="Internet.Hyperlink" Value="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Number" Description="Number"/>
				<expression tag="String.Text" Value="which supports floating-point values."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Methods:"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following visualization-related methods must be implemented."/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="prepareDisplay(context)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method is responsible for calculating the expression's metrics; that is, it does not draw anything, it only performs the calculations necessary for the drawing itself."/>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The argument"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="context"/>
						</expression>
						<expression tag="String.Text" Value="is of type"/>
						<expression tag="Internet.Hyperlink" Value="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D" Description="CanvasRenderingContext2D"/>
						<expression tag="String.Text" Value=", which is the class normally used to manipulate graphical content."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="display(context, x, y)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method performs the drawing of the expression."/>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The arguments"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="x"/>
						</expression>
						<expression tag="String.Text" Value="and"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="y"/>
						</expression>
						<expression tag="String.Text" Value="indicate the absolute position of the origin of the current expression's rectangle, that is, of its top-left corner."/>
					</expression>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Rules"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Not all instances of a class will be displayed; there may be expressions that are created to perform intermediate calculations, with the resulting expression being the only one displayed."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The framework guarantees that a call will never be made to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="if there has not been a previous call to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="(for the same expression object)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The calls to the methods"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="are not one-to-one (for the same expression); for each call to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="there may be one or several calls to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Although the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="does not draw the expression, it can perform graphical operations necessary for calculating metrics, for example changing graphical attributes such as the font type or style."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If the expression requires metrics beyond the common ones, it can create them. However, the correct way to do this is for them to be created by the call to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="and NOT as attributes of the class definition itself. In turn, these attributes should only be used (read) by the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The graphical context"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="context"/>
				</expression>
				<expression tag="String.Text" Value="preserves state, such as the font or the drawing color. If it must be modified as part of the work the methods must do"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value=", they must leave the state of this context in the same situation it was in at the start of the call. This is typically achieved by saving the value of the attribute or attributes to be changed, so that before the method finishes executing, they can be restored."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following is an example of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="for an expression that performs drawing operations in a color different from the default:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="display(context, x, y) {&#10;&#9;let bkpStrokeStyle = context.strokeStyle;    // save the style&#10;&#9;context.strokeStyle = &quot;red&quot;;                 // change the style&#10;&#9;&#10;&#9;// Perform the graphical operations&#10;&#9;// those that use the attribute, for example line drawing&#10;&#9;// will be drawn in red&#10;&#9;&#10;&#9;context.strokeStyle = bkpStrokeStyle;      // restore the style&#10;}"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Although an expression contains several metrics, the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="must calculate and assign the metrics"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="width"/>
				</expression>
				<expression tag="String.Text" Value=","/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="height"/>
				</expression>
				<expression tag="String.Text" Value=","/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="horzBaseline"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="vertBaseline"/>
				</expression>
				<expression tag="String.Text" Value="of itself, but NOT the metrics"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="x"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="y"/>
				</expression>
				<expression tag="String.Text" Value=", since these must only be calculated and assigned by the parent expression. For this same reason, an expression must calculate and assign the metrics"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="x"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="y"/>
				</expression>
				<expression tag="String.Text" Value="of EACH of its subexpressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="When the expression has subexpressions, the most common thing is for the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="to call this same method for each of the subexpressions before calculating and assigning the metrics, since calculating the metrics of the current expression will surely require the metrics of each of the subexpressions. Note that this is not a form of recursion, since the method is not invoked for the same expression, but for the subexpressions."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The addition expression will be used to illustrate the implementation of visualization. It is useful to structure, or even draw on paper, a diagram like the following one, showing the sizes, positions, and metrics of both the expression to be displayed (in this case the sum) and those of the subexpressions (the addends):"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Visualization.Metrics">
					<expression tag="Math.Arithmetic.Addition">
						<expression tag="Visualization.Selected">
							<expression tag="Visualization.Metrics">
								<expression tag="Visualization.Rectangle" Width="10" Height="10" HorizontalBaseline="5" VerticalBaseline="5"/>
							</expression>
						</expression>
						<expression tag="Visualization.Selected">
							<expression tag="Visualization.Metrics">
								<expression tag="Visualization.Rectangle" Width="10" Height="30" HorizontalBaseline="15" VerticalBaseline="5"/>
							</expression>
						</expression>
						<expression tag="Visualization.Selected">
							<expression tag="Visualization.Metrics">
								<expression tag="Visualization.Rectangle" Width="25" Height="20" HorizontalBaseline="5" VerticalBaseline="5"/>
							</expression>
						</expression>
						<expression tag="Visualization.Selected">
							<expression tag="Visualization.Metrics">
								<expression tag="Visualization.Rectangle" Width="50" Height="50" HorizontalBaseline="45" VerticalBaseline="25"/>
							</expression>
						</expression>
						<expression tag="Visualization.Selected">
							<expression tag="Visualization.Metrics">
								<expression tag="Visualization.Rectangle" Width="10" Height="10" HorizontalBaseline="5" VerticalBaseline="5"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="must do the following:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="First, the metrics of the subexpressions (the addends) must be calculated, by calling the method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="prepareDisplay(context)"/>
					</expression>
					<expression tag="String.Text" Value="of each of them."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Calculate the width of the symbol text (+) in the current font."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Then the positions must be calculated and set"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="x"/>
					</expression>
					<expression tag="String.Text" Value="and"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="y"/>
					</expression>
					<expression tag="String.Text" Value="of each of them so that they are arranged side by side, leaving space to draw the (+) symbols, and ensuring that the horizontal baselines of each of them are aligned."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Finally, the addition expression can now calculate its own metrics. Note that its horizontal baseline is set so that it is also aligned with the horizontal baselines of the addends. The vertical baseline is at the middle of the expression's width."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="must do the following:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Draw its subexpressions, by calling the method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="display(context, x, y)"/>
					</expression>
					<expression tag="String.Text" Value="of each of them."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Draw the (+) symbol between each of the subexpressions."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There may be confusion between the arguments"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="x"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="y"/>
				</expression>
				<expression tag="String.Text" Value="and the attributes of the same name of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value=". The following is an approximate version of the code of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value=":"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Addition = class extends Expression {&#10;&#9;:&#10;&#9;&#10;&#9;prepareDisplay(context) ...&#10;&#9;&#10;&#9;display(context, x, y) {&#10;&#9;&#9;// draw each of the addends&#10;&#9;&#9;&#10;&#9;&#9;let child;&#10;&#9;&#9;for (let i = 0, n = this.children.length; i &lt; n; ++i) {&#10;&#9;&#9;&#9;child = this.children[i];&#10;&#9;&#9;&#9;child.display(context, x + child.x, y + child.y);&#10;&#9;&#9;}&#10;&#9;&#9;&#10;&#9;&#9;// draw the addition symbols&#10;&#9;&#9;:&#10;&#9;}&#10;&#9;&#10;&#9;:&#10;}"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Visual artifacts"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In this section, the term &quot;artifact&quot; should not be understood in the (negative) sense it usually has within visual representation techniques, whether defects or anomalies, for example"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Moir%C3%A9_pattern" Description="moiré patterns."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Instead, they should be seen from the point of view of"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Semiotics" Description="semiotics,"/>
				<expression tag="String.Text" Value="that is, they are symbolic elements of an arbitrary and conventional nature, agreed upon"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/De_facto_standard" Description="de facto"/>
				<expression tag="String.Text" Value="for a society or culture. From this point of view, the study of visual artifacts falls within the field of"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Human-computer_interaction" Description="human-computer interaction."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It should also be understood that an artifact is not an essential part of an expression, but rather an additional visual element, used to indicate the semantics, to remove ambiguity in the semantics, or simply as a decorative element."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Parentheses"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="One of the best-known visual artifacts is parentheses, widely used both in mathematics and in textual programming languages."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Consider the following expression, provided as an inverted tree:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="×"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Symbolic.Symbol" Name="a"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="+"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Symbolic.Symbol" Name="b"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Symbolic.Symbol" Name="c"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="One of the benefits of structuring expressions this way is that there is no ambiguity in how expressions are grouped with one another. Concepts such as"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Order_of_operations" Description="precedence"/>
				<expression tag="String.Text" Value="or"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Operator_associativity" Description="associativity."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="However, when displaying the expression in a way that is natural for humans or for textual programming languages, it is sometimes necessary to show parentheses. For our example, the expression must be shown as:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Math.Arithmetic.Multiplication">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Math.Arithmetic.Addition">
						<expression tag="Symbolic.Symbol" Name="b"/>
						<expression tag="Symbolic.Symbol" Name="c"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Without them, the expression has a different meaning:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Math.Arithmetic.Addition">
					<expression tag="Math.Arithmetic.Multiplication">
						<expression tag="Symbolic.Symbol" Name="a"/>
						<expression tag="Symbolic.Symbol" Name="b"/>
					</expression>
					<expression tag="Symbolic.Symbol" Name="c"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The idea of visualizations in the Fōrmulæ language is that they determine on their own when expressions should be shown with parentheses, without the end user having to specify them explicitly; in other words, parentheses are visual artifacts that the expression visualization implementation must automatically determine and show. There is no parenthesis expression whose function is to group a set of expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The most common mechanism for determining the precedence and associativity of operations is to use a table that indicates the precedence values (usually as a number), and those that have the same value appear in the same range but indicating a different associativity (typically as an ordered list, from highest to lowest associativity)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="However, that cannot be done with the Fōrmulæ language, since it does not have a predefined set of operators; the language can be extended with new expressions at any time."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In Fōrmulæ, there is a relatively simple rule: an expression does not decide whether it should show itself in parentheses; rather, a parent expression decides whether one (or several) of its subexpressions should be shown in parentheses (as part of its implementation of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="prepareDisplay(context)"/>
				</expression>
				<expression tag="String.Text" Value="), as well as actually doing it within its implementation of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The expression recognizes the &quot;visual&quot; nature of each of its subexpressions, since there are methods of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value="that indicate it. These methods are:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parenthesesAsOperator()"/>
						</expression>
						<expression tag="String.Text" Value="returns a boolean value, and its default implementation returns"/>
						<expression tag="Typesetting.ItalicChunk">
							<expression tag="String.Text" Value="false."/>
						</expression>
						<expression tag="String.Text" Value="An expression implementation can override it to indicate that the expression's visualization lays out its subexpressions one by one in a primarily horizontal manner. Basically, it indicates that if a &quot;sibling&quot; expression is placed to the left or right of the current expression, it will produce an appearance that confuses the semantics of the expressions."/>
						<expression tag="String.Text" Value="The earlier addition exercise where one addend is a multiplication is an example of this type; the addition expression should implement the method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parenthesesAsOperator()"/>
						</expression>
						<expression tag="String.Text" Value="to return a"/>
						<expression tag="Typesetting.ItalicChunk">
							<expression tag="String.Text" Value="true."/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Some examples of expressions of this type are those that are displayed as infix operations of low associativity, such as addition, but not multiplication, since it is of high associativity."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parenthesesWhenSuperSubscripted()"/>
						</expression>
						<expression tag="String.Text" Value="returns a boolean value, and its default implementation returns"/>
						<expression tag="Typesetting.ItalicChunk">
							<expression tag="String.Text" Value="false."/>
						</expression>
						<expression tag="String.Text" Value="An expression implementation can override it to indicate that the expression has two subexpressions, and that the second is shown either as a superscript or a subscript of the first."/>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Examples of expressions of this type are exponentiation or the operation of obtaining one subexpression from another, as in"/>
						<expression tag="Expression.Child">
							<expression tag="Symbolic.Symbol" Name="x"/>
							<expression tag="Symbolic.Symbol" Name="i"/>
						</expression>
						<expression tag="String.Text" Value="(obtain the i-th subexpression of"/>
						<expression tag="Symbolic.Symbol" Name="x"/>
						<expression tag="String.Text" Value=")."/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Note that even if an expression overrides one of the methods"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parenthesesAsOperator()"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parenthesesWhenSuperSubscripted()"/>
				</expression>
				<expression tag="String.Text" Value=", to return the value"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="true,"/>
				</expression>
				<expression tag="String.Text" Value="it does NOT mean that they must be shown in parentheses; the parent expression must decide, according to its own visualization form, whether the subexpression should be shown in parentheses. For example, the addition expression must return the value"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="true"/>
				</expression>
				<expression tag="String.Text" Value="in the implementation of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parenthesesAsOperator()"/>
				</expression>
				<expression tag="String.Text" Value=", which is useful to a parent multiplication expression, so that it shows parentheses as in the example"/>
				<expression tag="Math.Arithmetic.Multiplication">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Math.Arithmetic.Addition">
						<expression tag="Symbolic.Symbol" Name="b"/>
						<expression tag="Symbolic.Symbol" Name="c"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value=", however it is not useful for the division expression, since this property does not help it determine whether the subexpression should be shown in parentheses, as in"/>
				<expression tag="Math.Arithmetic.Division">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Math.Arithmetic.Addition">
						<expression tag="Symbolic.Symbol" Name="b"/>
						<expression tag="Symbolic.Symbol" Name="c"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value=". Other expressions never call the methods"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parenthesesAsOperator()"/>
				</expression>
				<expression tag="String.Text" Value="or"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parenthesesWhenSuperSubscripted()"/>
				</expression>
				<expression tag="String.Text" Value="because their subexpressions are never shown with parentheses, regardless of their type, for example in a square root"/>
				<expression tag="Math.Arithmetic.SquareRoot">
					<expression tag="Math.Arithmetic.Exponentiation">
						<expression tag="Symbolic.Symbol" Name="x"/>
						<expression tag="Math.Number" Value="10"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="(it is never used in the form"/>
				<expression tag="Math.Arithmetic.SquareRoot">
					<expression tag="Visualization.Parentheses">
						<expression tag="Math.Arithmetic.Exponentiation">
							<expression tag="Symbolic.Symbol" Name="x"/>
							<expression tag="Math.Number" Value="10"/>
						</expression>
					</expression>
				</expression>
				<expression tag="String.Text" Value="), or the elements of a list or array:"/>
				<expression tag="List.List">
					<expression tag="Symbolic.Symbol" Name="x"/>
					<expression tag="Symbolic.Symbol" Name="y"/>
					<expression tag="Symbolic.Symbol" Name="z"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="drawParenthesesAround(context, x, y)"/>
				</expression>
				<expression tag="String.Text" Value="draws the pair of parentheses around the expression that invokes it. The arguments"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="x"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="y"/>
				</expression>
				<expression tag="String.Text" Value="define the absolute position of the origin of the expression. It must be invoked exclusively within the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="display(context, x, y)"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Traversability"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The environment in which expressions are shown and edited is graphical, and therefore usable with the help of a device that allows"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Point_and_click" Description="point and click"/>
				<expression tag="String.Text" Value="operations (for example a mouse). However, more experienced users and programmers find the additional use of the keyboard helpful for editing expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Traversability is the ability to select"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="any"/>
				</expression>
				<expression tag="String.Text" Value="expression or subexpression, no matter how complex, using only the arrow keys and the"/>
				<expression tag="Visualization.Key">
					<expression tag="String.Text" Value="ESC"/>
				</expression>
				<expression tag="String.Text" Value="key. It can be summarized as follows:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Given an expression that is selected, whether or not it is a terminal expression, using one of the arrow keys causes an expression to be selected, always a terminal one, according to the chosen direction. The new expression need not necessarily be a &quot;sibling&quot; of the currently selected expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Using the"/>
					<expression tag="Visualization.Key">
						<expression tag="String.Text" Value="ESC"/>
					</expression>
					<expression tag="String.Text" Value="key causes the parent expression of the selected expression, if it exists, to become the new selected expression."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Example"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Key"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Result"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Arithmetic.Addition">
