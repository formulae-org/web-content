<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.graphics.raster,org.formulae.visualization,org.formulae.text.string,org.formulae.internet,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Centering">
				<expression tag="Graphics.RasterGraphics" Value="" Format="image/png"/>
			</expression>
			<expression tag="Visualization.FontSize" Size="32">
				<expression tag="Typesetting.Centering">
					<expression tag="String.Text" Value="Fōrmulæ"/>
					<expression tag="String.Text" Value="Developer's guide"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Introduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Welcome! If you are a developer and you want to build packages for the Fōrmulæ programming language, this document is for you."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Requirements"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="What you will need is:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Knowledge of the JavaScript language."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Knowledge of the JSON format."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Knowledge of the"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Git" Description="Git"/>
					<expression tag="String.Text" Value="protocol and an account on the"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/GitHub" Description="GitHub"/>
					<expression tag="String.Text" Value="site, since that is where the source-code and documentation repositories are located."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="An open mind. The Fōrmulæ language and its programming are nothing like other languages or pieces of software you may know."/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Contents"/>
				</expression>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 1."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Introduction" Description="Introduction"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 2."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Preparation" Description="Preparation"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 3."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Expressions" Description="Defining expressions"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 4."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Visualization" Description="Visualizing expressions"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 5."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Edition" Description="Editing expressions"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 6."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Reduction" Description="Reducing expressions"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 7."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Internationalization" Description="Internationalization"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Chapter 8."/>
					<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Complete_example" Description="A complete example: Morse code"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781784000000"/>
			</expression>
		</expression>
	</expression>
</expression>