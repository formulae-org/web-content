<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.list,org.formulae.visualization,org.formulae.diagramming,org.formulae.symbolic,org.formulae.math.arithmetic,org.formulae.internet,org.formulae.graphics.raster,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Editing"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Editing refers to the creation of expressions, or the modification of existing expressions, in a natural way."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Introduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As is already known, the data structure with which expressions are internally represented is the &quot;inverted tree&quot;, since it has interesting properties, for example, not requiring concepts of precedence or associativity."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="However, just as with visualization, it is not acceptable for the user to create or modify inverted trees directly; they must do so in a more natural way."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This section presents the editing scheme created for use in the Fōrmulæ working environment."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Selected expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Expression editing is based on the concept of the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="selected expression."/>
				</expression>
				<expression tag="String.Text" Value="It is the expression to which editing is applied. It is always shown in reverse video. Evidently it can be part or all of a given expression; see the following examples:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="Visualization.VerticalArray">
									<expression tag="String.Text" Value="Inverted tree, showing"/>
									<expression tag="String.Text" Value="the selected expression"/>
								</expression>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="Visualization.VerticalArray">
									<expression tag="String.Text" Value="Visualization of"/>
									<expression tag="String.Text" Value="the selected expression"/>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="String.Text" Value="Addition"/>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Visualization.Selected">
										<expression tag="Symbolic.Symbol" Name="a"/>
									</expression>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Visualization.Selected">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
								<expression tag="Symbolic.Symbol" Name="b"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="String.Text" Value="Addition"/>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Visualization.Selected">
										<expression tag="Symbolic.Symbol" Name="b"/>
									</expression>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Symbolic.Symbol" Name="a"/>
								<expression tag="Visualization.Selected">
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Visualization.Selected">
									<expression tag="String.Text" Value="Addition"/>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
							</expression>
							<expression tag="Visualization.Selected">
								<expression tag="Math.Arithmetic.Addition">
									<expression tag="Symbolic.Symbol" Name="a"/>
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Properties and methods related to the selected expression."/>
				</expression>
				<expression tag="String.Text" Value="The following properties and methods apply for defining or querying the selected expression:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The property"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Formulae.sExpression"/>
					</expression>
					<expression tag="String.Text" Value="is a reference to the selected expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The property"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Formulae.sHandler"/>
					</expression>
					<expression tag="String.Text" Value="is a reference to the handler of the selected expression."/>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Formulae.setSelected(handler, expression, removePrevious)"/>
						</expression>
						<expression tag="String.Text" Value="is used to set the selected expression. The selected expression is shown in reverse video. The method does not return useful values. The arguments it receives are:"/>
					</expression>
					<expression tag="Typesetting.BulletedList">
						<expression tag="Typesetting.Paragraph">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="handler"/>
							</expression>
							<expression tag="String.Text" Value="is the expression handler that contains the expression to be selected."/>
						</expression>
						<expression tag="Typesetting.Paragraph">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="expression"/>
							</expression>
							<expression tag="String.Text" Value="is the expression to be set as the selected expression."/>
						</expression>
						<expression tag="Typesetting.Paragraph">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="removePrevious"/>
							</expression>
							<expression tag="String.Text" Value="is a boolean value to indicate that the method must remove the previously selected expression from reverse video."/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Rule"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Highlighted expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As you move the mouse cursor, you can see that the different expressions it passes over are highlighted in a blue box, to indicate that it is the highlighted expression. This highlighted expression serves to indicate that if you click with the mouse, the highlighted expression will become the new selected expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If you click with the mouse and there is no highlighted expression, the selected expression remains unchanged."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Null expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The null expression, displayed as"/>
				<expression tag="Null"/>
				<expression tag="String.Text" Value=", is a very widely used expression. Although from a visual and semantic point of view it has no value, for editing expressions it is very useful, since it works as a wildcard expression, occupying a place as a subexpression. It is similar to the numeral zero in our positional number system: on its own it means &quot;no quantity, or without quantity&quot;, but at a structural level, in the positional organization of numerals it plays an important role, so much so that the &quot;discovery&quot; (or &quot;invention&quot;?) of zero is considered an extremely important milestone in the development of the mathematical sciences."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Edits"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="An edit is a set of code whose purpose is to alter an expression starting from the selected expression (which is all or part of that expression). The modification of the inverted tree is done with the methods already shown in the &quot;Expressions&quot; section, for example to insert or remove nodes."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are three broad types of edits:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Universal edits."/>
					</expression>
					<expression tag="String.Text" Value="They are pieces of code to perform specific actions that work for any type of expression. Since they work for any expression, hence their name (&quot;universal&quot;). Their programming is part of the framework itself. An example of this type of edit is the operation of"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="Deleting"/>
					</expression>
					<expression tag="String.Text" Value="the selected expression, by using the"/>
					<expression tag="Visualization.Key">
						<expression tag="String.Text" Value="DEL"/>
					</expression>
					<expression tag="String.Text" Value="key, or the cut/copy/paste operations."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Creational edits."/>
					</expression>
					<expression tag="String.Text" Value="If you are a creator of new expressions, in addition to defining them and specifying how they will be displayed, you must also define how they can be created. All the options that appear in the left panel are creational edits. All these edits work based on the selected expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Actions."/>
					</expression>
					<expression tag="String.Text" Value="They are pieces of code that run when the selected expression is of a specific type (tag)."/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example, expressions with internal state"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Let us look at the example of expressions with internal state, for example numbers, strings, or dates. This type of expression typically has a creational edit with which we interactively enter the value of the internal state needed for the expression, plus an action to modify that internal state."/>
			</expression>
			<expression tag="Typesetting.Rule"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Creational edits"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Creational edits are used to introduce new expressions into a larger expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A creational edit always takes the selected expression into account."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A creational edit always defines what the new selected expression will be at the end of the edit. It can be the same expression that was selected before the edit."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It is common for a creational edit to also create one or several null expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example, an edit to create a division."/>
				</expression>
				<expression tag="String.Text" Value="A possible edit to create a division can work as follows:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The selected expression will be the dividend of the division"/>
				</expression>
				<expression tag="String.Text" Value="The divisor will be a new null expression"/>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The new selected expression will be the divisor (the null expression)."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="See the following examples:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Before editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="After editing"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Visualization.Selected">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
								<expression tag="Symbolic.Symbol" Name="b"/>
							</expression>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Math.Arithmetic.Division">
									<expression tag="Symbolic.Symbol" Name="a"/>
									<expression tag="Visualization.Selected">
										<expression tag="Null"/>
									</expression>
								</expression>
								<expression tag="Symbolic.Symbol" Name="b"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Symbolic.Symbol" Name="a"/>
								<expression tag="Visualization.Selected">
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Symbolic.Symbol" Name="a"/>
								<expression tag="Math.Arithmetic.Division">
									<expression tag="Symbolic.Symbol" Name="b"/>
									<expression tag="Visualization.Selected">
										<expression tag="Null"/>
									</expression>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Visualization.Selected">
								<expression tag="Math.Arithmetic.Addition">
									<expression tag="Symbolic.Symbol" Name="a"/>
									<expression tag="Visualization.Selected">
										<expression tag="Symbolic.Symbol" Name="b"/>
									</expression>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Division">
								<expression tag="Math.Arithmetic.Addition">
									<expression tag="Symbolic.Symbol" Name="a"/>
									<expression tag="Symbolic.Symbol" Name="b"/>
								</expression>
								<expression tag="Visualization.Selected">
									<expression tag="Null"/>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Arithmetic.SquareRoot">
								<expression tag="Visualization.Selected">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.SquareRoot">
								<expression tag="Math.Arithmetic.Division">
									<expression tag="Symbolic.Symbol" Name="a"/>
									<expression tag="Visualization.Selected">
										<expression tag="Null"/>
									</expression>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Visualization.Selected">
								<expression tag="Math.Arithmetic.SquareRoot">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Division">
								<expression tag="Math.Arithmetic.SquareRoot">
									<expression tag="Symbolic.Symbol" Name="a"/>
								</expression>
								<expression tag="Visualization.Selected">
									<expression tag="Null"/>
								</expression>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Trigonometric.Cosine">
								<expression tag="Math.Arithmetic.Addition">
									<expression tag="Symbolic.Symbol" Name="x"/>
									<expression tag="Visualization.Selected">
										<expression tag="Math.Number" Value="1"/>
									</expression>
								</expression>
							</expression>
							<expression tag="Math.Trigonometric.Cosine">
								<expression tag="Math.Arithmetic.Addition">
									<expression tag="Symbolic.Symbol" Name="x"/>
									<expression tag="Math.Arithmetic.Division">
										<expression tag="Math.Number" Value="1"/>
										<expression tag="Visualization.Selected">
											<expression tag="Null"/>
										</expression>
									</expression>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Adding an edit to the environment."/>
				</expression>
				<expression tag="String.Text" Value="To add an edit, and make it appear in the left panel of the work area, you must make a call to the following method:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.addEdition(spec, image, name, edition)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Where:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="spec"/>
					</expression>
					<expression tag="String.Text" Value="is a string that specifies the location of the edit in the tree. It is formed in a way similar to the definition of"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="tags,"/>
					</expression>
					<expression tag="String.Text" Value="that is, it is of the form"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="node1.node2,....,nodeN"/>
					</expression>
					<expression tag="String.Text" Value="that is, it consists of a set of dot-separated strings that specify the location in the edition tree. The substrings, unlike"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="tags"/>
					</expression>
					<expression tag="String.Text" Value="can contain spaces and special characters. An example is"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Mathematics.Arithmetic"/>
					</expression>
					<expression tag="String.Text" Value="."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="image"/>
					</expression>
					<expression tag="String.Text" Value="is a string indicating the image file to be used. It can be of any format, but PNG is recommended, because of transparency. The null value can be specified, to indicate that no image will be shown."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="name"/>
					</expression>
					<expression tag="String.Text" Value="is a string with the name to be shown for the edit. It can be the null value. An example is"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Square root"/>
					</expression>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="edition"/>
					</expression>
					<expression tag="String.Text" Value="is a"/>
					<expression tag="Internet.Hyperlink" Value="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/function" Description="function expression"/>
					<expression tag="String.Text" Value="that contains the code that will be called when the user selects the edit. The function receives no arguments and no return value is expected."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As an example, the following code is used to register the edit seen earlier for creating a division:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="const divisionEdition = () =&gt; {&#10;&#9;// Make the changes in the expression tree&#10;&#9;&#10;&#9;let nullExpression = Formulae.createExpression(&quot;Null&quot;);&#10;&#9;let divisionExpression = Formulae.createExpression(&quot;Math.Arithmetic.Division&quot;);&#10;&#9;&#10;&#9;Formulae.sExpression.replaceBy(divisionExpression);&#10;&#9;divisionExpression.addChild(Formulae.sExpression);&#10;&#9;divisionExpression.addChild(nullExpression);&#10;&#9;&#10;&#9;// Define the new selected expression&#10;&#9;&#10;&#9;Formulae.sHandler.prepareDisplay();&#10;&#9;Formulae.sHandler.display();&#10;&#9;Formulae.setSelected(Formulae.sHandler, nullExpression, false);&#10;};&#10;&#10;Formulae.addEdition(&#10;&#9;&quot;Mathematics.Arithmetic&quot;, // Location in the edition tree&#10;&#9;null,                     // No image&#10;&#9;&quot;Division&quot;,               // Name&#10;&#9;divisionEdition           // Edition&#10;);"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Predefined edits"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Because it is common to have code to create the expressions required by edits, there is a set of predefined edits:"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression.replacingEdition(tag)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This method creates a new expression, from the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="that is passed as an argument. The expression is created without subexpressions, so it should be a type of expression that does not require them (for example a number expression). The new expression replaces the currently selected one, and becomes the new selected expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression.wrapperEdition(tag)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This method creates a new expression from the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="that is passed as an argument. The new expression is assigned a single subexpression, the currently selected expression, so it should be a type of expression that requires a single subexpression (for example a square root). The currently selected expression persists as such."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression.binaryEdition(tag, nullFirst)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This method creates a new expression from the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="that is passed as an argument. The new expression will have two subexpressions, one will be the new expression and the other the null expression, so it should be a type of expression that accepts at least two subexpressions (for example an addition). The currently selected expression persists as such. The argument"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="nullFirst"/>
				</expression>
				<expression tag="String.Text" Value="of boolean type, indicates whether the null expression will be the first (true) or the second (false)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression.multipleEdition(tag, n, i)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="This method creates a new expression from the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="that is passed as an argument. The new expression will have as many subexpressions as indicated by the argument,"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="n"/>
				</expression>
				<expression tag="String.Text" Value="and one of them, the one indicated by the argument"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="i"/>
				</expression>
				<expression tag="String.Text" Value="will be the new expression and the other the null expression, so it should be a type of expression that accepts the indicated number of subexpressions. The currently selected expression persists as such."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Based on the above, the following table is a guide to which method to call, based on the number of subexpressions the new expression will have:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Number of subexpressions"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Method"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Number" Value="0"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="Expression.replacingEdition(tag)"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Number" Value="1"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="Expression.wrapperEdition(tag)"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Number" Value="2"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="Expression.binaryEdition(tag, nullFirst)"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="String.Text" Value="More than 2"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="Expression.multipleEdition(tag, n, i)"/>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In this way, the previous example becomes more concise as follows:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Formulae.addEdition(&#10;&#9;&quot;Mathematics.Arithmetic&quot;,&#10;&#9;null,&#10;&#9;&quot;Division&quot;,&#10;&#9;() =&gt; Expression.binaryEdition(&quot;Math.Arithmetic.Division&quot;, false)&#10;);"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Edits with interactivity"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are times when editing requires some degree of interactivity, for example for the creation of expressions with internal values such as strings or dates, it is necessary to ask the user for the information of that internal state."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Such interactivity is achieved by means of a dialog box. It is the programmer's responsibility to design a DOM element, and to respond to the various controls it contains as well as to perform validations. Part of those controls is an &quot;Ok&quot; or &quot;Accept&quot; button. Once that DOM element is created, the framework provides the following resources:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Formulae.setModal(element)"/>
					</expression>
					<expression tag="String.Text" Value="is used to place the element created by the programmer in the system interface in a modal way, that is, disabling the use of the elements that were already in the interface."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Formulae.resetModal()"/>
					</expression>
					<expression tag="String.Text" Value="removes from the user interface any element that was found, making the interface elements available again. This method is typically called when the user has finished using the DOM element, for example, when pressing the &quot;Ok&quot; or &quot;Accept&quot; button."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Other examples of edits"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Edits are not limited to the creation of a single new expression. Below are examples of interesting edits:"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example 1. Subtraction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In Fōrmulæ there is no expression for subtraction; the expression displayed as"/>
				<expression tag="Math.Arithmetic.Addition">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Math.Arithmetic.Negative">
						<expression tag="Symbolic.Symbol" Name="b"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="is internally an addition with a negative addend, as in"/>
				<expression tag="Math.Arithmetic.Addition">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Visualization.Parentheses">
						<expression tag="Math.Arithmetic.Negative">
							<expression tag="Symbolic.Symbol" Name="b"/>
						</expression>
					</expression>
				</expression>
				<expression tag="String.Text" Value=". However, since subtraction is indeed a common operation (for humans), there is an edit to &quot;create&quot; a subtraction. This edit does the following:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="It creates an arithmetic negation expression, and its only subexpression is a new null expression"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="An addition expression is created, where the first addend is the currently selected expression and the second is the negation expression shown above."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The addition expression will replace the currently selected expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Finally, the new selected expression is the null expression created in step 1."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Before editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="After editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Visually"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Visualization.Selected">
								<expression tag="Symbolic.Symbol" Name="x"/>
							</expression>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="String.Text" Value="Addition"/>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="Symbolic.Symbol" Name="x"/>
								</expression>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="String.Text" Value="Negative"/>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="Visualization.Selected">
											<expression tag="Null"/>
										</expression>
									</expression>
								</expression>
							</expression>
							<expression tag="Math.Arithmetic.Addition">
								<expression tag="Symbolic.Symbol" Name="x"/>
								<expression tag="Math.Arithmetic.Negative">
									<expression tag="Visualization.Selected">
										<expression tag="Null"/>
									</expression>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example 2. Creating a matrix"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In Fōrmulæ there are lists or arrays, which are shown as"/>
				<expression tag="List.List">
					<expression tag="Symbolic.Symbol" Name="a"/>
					<expression tag="Symbolic.Symbol" Name="b"/>
					<expression tag="Symbolic.Symbol" Name="c"/>
				</expression>
				<expression tag="String.Text" Value=". If all the elements of a list are themselves lists of the same cardinality, this &quot;list of lists&quot; is shown as a matrix, as in"/>
				<expression tag="List.List">
					<expression tag="List.List">
						<expression tag="Symbolic.Symbol" Name="a"/>
						<expression tag="Symbolic.Symbol" Name="b"/>
						<expression tag="Symbolic.Symbol" Name="c"/>
					</expression>
					<expression tag="List.List">
						<expression tag="Symbolic.Symbol" Name="x"/>
						<expression tag="Symbolic.Symbol" Name="y"/>
						<expression tag="Symbolic.Symbol" Name="z"/>
					</expression>
					<expression tag="List.List">
						<expression tag="Symbolic.Symbol" Name="p"/>
						<expression tag="Symbolic.Symbol" Name="q"/>
						<expression tag="Symbolic.Symbol" Name="r"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Although it is possible to create a matrix step by step, there is an edit that, given an expression (the selected expression), clones it to form the elements of a matrix, interactively asking for the number of rows and columns. The new selected expression is the one that ends up in the first row and column of the matrix. See the following example:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Before editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Editing"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="After editing"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Visualization.Selected">
								<expression tag="Math.Number" Value="0"/>
							</expression>
							<expression tag="Graphics.RasterGraphics" Value="" Format="image/png"/>
							<expression tag="List.List">
								<expression tag="List.List">
									<expression tag="Visualization.Selected">
										<expression tag="Math.Number" Value="0"/>
									</expression>
									<expression tag="Math.Number" Value="0"/>
									<expression tag="Math.Number" Value="0"/>
								</expression>
								<expression tag="List.List">
									<expression tag="Math.Number" Value="0"/>
									<expression tag="Math.Number" Value="0"/>
									<expression tag="Math.Number" Value="0"/>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Actions"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="An action is a piece of code that is associated with the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="of the selected expression. The associated code does not necessarily have to alter the selected expression; it can be any operation associated with the expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="can have zero, one, or several actions associated with it. In the case of several, one of them (the first one registered) has priority. The priority action is executed by pressing the"/>
				<expression tag="Visualization.Key">
					<expression tag="String.Text" Value="SPACE"/>
				</expression>
				<expression tag="String.Text" Value="key (with the selected expression being the one that has the actions associated). If there are several actions, the way to choose them is by right-clicking with the mouse while the desired expression is highlighted; this will generate a pop-up menu containing the available actions, plus options common to all expressions (such as cut, copy, or paste)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For example, refer to the following expression, which is a web link:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Internet.Hyperlink" Value="formulae.org" Description="Link to the Fōrmulæ page"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If you are in editing mode, right-clicking on the link will generate the following pop-up menu:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Graphics.RasterGraphics" Value="" Format="image/png"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Which shows that the expression has three actions:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Open link."/>
					</expression>
					<expression tag="String.Text" Value="This option will make the browser where the environment is running open a new tab with the web address associated with the expression. Note that this option is the priority one, so it can also be activated with the"/>
					<expression tag="Visualization.Key">
						<expression tag="String.Text" Value="SPACE"/>
					</expression>
					<expression tag="String.Text" Value="key if the link expression is the selected one."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Typesetting.BoldChunk">
						<expression tag="String.Text" Value="Copy the address."/>
					</expression>
					<expression tag="String.Text" Value="This copies the address associated with the expression to the clipboard."/>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Edit link."/>
						</expression>
						<expression tag="String.Text" Value="This option opens a dialog box so that the web link expression can be edited, such as the address itself, or the text with which the link appears; see the following example:"/>
					</expression>
					<expression tag="Typesetting.Centering">
						<expression tag="Graphics.RasterGraphics" Value="" Format="image/png"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Adding an action to the environment."/>
				</expression>
				<expression tag="String.Text" Value="To add an action, you must make a call to the following method:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.addAction(tag, action)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Where:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="tag"/>
					</expression>
					<expression tag="String.Text" Value="is the tag to which the action will be associated."/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="tags,"/>
					</expression>
					<expression tag="String.Text" Value="that is, it is of the form"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="node1.node2,....,nodeN"/>
					</expression>
					<expression tag="String.Text" Value="that is, it consists of a set of dot-separated strings that specify the location in the edition tree. The substrings, unlike"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="tags"/>
					</expression>
					<expression tag="String.Text" Value="can contain spaces and special characters. An example is"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Mathematics.Arithmetic"/>
					</expression>
					<expression tag="String.Text" Value="."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="action"/>
					</expression>
					<expression tag="String.Text" Value="is an"/>
					<expression tag="String.Text" Value="object that contains the code that will be called when the user selects the action."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As an example, the following code is used to register the action for modifying the value of a number expression:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Formulae.addAction(&quot;Math.Number&quot;, actionNumber);"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Registering the edits and actions that make up the package"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As already seen in the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Introduction" Description="introduction,"/>
				<expression tag="String.Text" Value="the definition of edits and actions is placed in a source file named"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="edition.js"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The general structure of this file is:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="edition.js"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="export class ArithmeticPackage extends Formulae.EditionPackage {};&#10;&#10;const editionNumber = function() {&#10;&#9;:&#10;};&#10;&#10;const actionNumber = {&#10;&#9;:&#10;};&#10;&#10;ArithmeticPackage.setEditions = function() {&#10;&#9;Formulae.addEdition(&quot;Mathematics.Arithmetic&quot;, null, &quot;Number&quot;,         editionNumber);&#10;&#9;Formulae.addEdition(&quot;Mathematics.Arithmetic&quot;, null, &quot;Addition&quot;,           () =&gt; Expression.binaryEdition(&quot;Math.Arithmetic.Addition&quot;,       false));&#10;&#9;Formulae.addEdition(&quot;Mathematics.Arithmetic&quot;, null, &quot;Multiplication&quot;, () =&gt; Expression.binaryEdition(&quot;Math.Arithmetic.Multiplication&quot;, false));&#10;&#9;Formulae.addEdition(&quot;Mathematics.Arithmetic&quot;, null, &quot;Exponentiation&quot;, () =&gt; Expression.binaryEdition(&quot;Math.Arithmetic.Exponentiation&quot;, false));&#10;};&#10;&#10;ArithmeticPackage.setActions = function() {&#10;&#9;Formulae.addAction(&quot;Math.Number&quot;, actionNumber);&#10;};"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The first part is the definition of the class that will represent our package, with respect to the definition of expressions it contains. The class must extend the base class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.ExpressionPackage"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Next, the definitions of the classes that represent the package's edits and actions are included."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As a next step, there must be the definition (in fact the rewriting) of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="setEditions(module)"/>
				</expression>
				<expression tag="String.Text" Value="of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.EditionPackage"/>
				</expression>
				<expression tag="String.Text" Value="(which originally does nothing). This method will be invoked by the framework each time the package is loaded for the first time. This method contains the calls to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.addEdition(spec, image, name, edition)"/>
				</expression>
				<expression tag="String.Text" Value="seen in the previous section."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Finally, if there were actions, there must be the definition (in fact the rewriting) of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="setActions()"/>
				</expression>
				<expression tag="String.Text" Value="of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.EditionPackage"/>
				</expression>
				<expression tag="String.Text" Value="(which originally does nothing). This method will be invoked by the framework each time the package is loaded for the first time. This method contains the calls to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.addAction(tag, action)"/>
				</expression>
				<expression tag="String.Text" Value="seen in the previous section."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
