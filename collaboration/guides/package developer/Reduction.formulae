				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Implications for reduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The above has the following implications for the reduction process; the most evident are:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="During reduction, you will never encounter expressions with the tags"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Number"/>
					</expression>
					<expression tag="String.Text" Value="or"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
					</expression>
					<expression tag="String.Text" Value=", but you will encounter"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.InternalNumber"/>
					</expression>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Therefore, there will be no reducers associated with the tags"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Number"/>
					</expression>
					<expression tag="String.Text" Value="or"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
					</expression>
					<expression tag="String.Text" Value="either, since if they existed they would never be invoked."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Your reducers' code must never create expressions with the tags"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Number"/>
					</expression>
					<expression tag="String.Text" Value="or"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
					</expression>
					<expression tag="String.Text" Value=", but rather of type"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.InternalNumber"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Support methods"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="To simplify the reduction process when numerical expressions are involved, the framework offers the following methods: "/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.createInternalNumber(n, session)."/>
					</expression>
					<expression tag="String.Text" Value="Creates an expression of type"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="InternalNumber"/>
					</expression>
					<expression tag="String.Text" Value="from the referenced number."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.getNativeInteger(expr)."/>
					</expression>
					<expression tag="String.Text" Value="If the indicated expression is of internal-number type, and the value of its internal state is an integer, or a decimal with an integer value, that can be stored in the value of the object"/>
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="Number"/>
					</expression>
					<expression tag="String.Text" Value="native to JavaScript, it returns it; otherwise it returns"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="undefined"/>
					</expression>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.getNativeBigInteger(expr)."/>
					</expression>
					<expression tag="String.Text" Value="If the indicated expression is of internal-number type, and the value of its internal state is an integer, or a decimal with an integer value, that can be stored in the value of the object"/>
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="BigInteger"/>
					</expression>
					<expression tag="String.Text" Value="native to JavaScript, it returns it; otherwise it returns"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="undefined"/>
					</expression>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.getInteger(expr)."/>
					</expression>
					<expression tag="String.Text" Value="Returns the number that the given expression has as its internal value, or"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="undefined"/>
					</expression>
					<expression tag="String.Text" Value="if the expression is not an internal number, or its associated value is not an integer."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.getDecimal(expr)."/>
					</expression>
					<expression tag="String.Text" Value="Returns the number that the given expression has as its internal value, or"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="undefined"/>
					</expression>
					<expression tag="String.Text" Value="if the expression is not an internal number."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.createInteger(n, session)."/>
					</expression>
					<expression tag="String.Text" Value="Creates an integer from the given number as an object of the native class"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="Number."/>
					</expression>
					<expression tag="String.Text" Value="returning an object of type"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="NumberI"/>
					</expression>
					<expression tag="String.Text" Value="if the session indicates that single precision is being used, or an object of type"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="BigInteger"/>
					</expression>
					<expression tag="String.Text" Value="if the session indicates that arbitrary precision is being used. If the native number is not an integer, it raises an exception."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.createDecimal(n, session)."/>
					</expression>
					<expression tag="String.Text" Value="Creates a decimal number from the given number as an object of the native class"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="Number."/>
					</expression>
					<expression tag="String.Text" Value="returning an object of type"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="NumberD"/>
					</expression>
					<expression tag="String.Text" Value="if the session indicates that single precision is being used, or an object of type"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="Decimal"/>
					</expression>
					<expression tag="String.Text" Value="if the session indicates that arbitrary precision is being used."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.createRational(n, d)."/>
					</expression>
					<expression tag="String.Text" Value="Returns a rational number from two integers representing the numerator and denominator. It throws an exception of type"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.ConversionError"/>
					</expression>
					<expression tag="String.Text" Value="if any of the values is not an integer. It throws an exception of type"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.DivisionByZeroError"/>
					</expression>
					<expression tag="String.Text" Value="if the denominator value is zero. The result may be different from the one entered; for example, if invoked with values 3 and 6 it returns the rational"/>
					<expression tag="Math.Arithmetic.Division">
						<expression tag="Math.Number" Value="1"/>
						<expression tag="Math.Number" Value="2"/>
					</expression>
					<expression tag="String.Text" Value="it can also return an integer if the numerator is a multiple of the denominator; for example, if invoked with values 12 and 3, it returns the integer 4."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.createComplex(r, i)."/>
					</expression>
					<expression tag="String.Text" Value="Returns a complex number from two numbers representing the real part and the imaginary part. The numbers can be integers, decimals, or rationals, and both need not be of the same type. It throws an exception of type"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Arithmetic.ConversionError"/>
					</expression>
					<expression tag="String.Text" Value="if either or both of the values are not integers, decimals, or rationals."/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Special reducers"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Until now, a reducer's code runs after the reducers of each and every one of its subexpressions have been executed and exhausted."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There is a class of reducers, called"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="special reducers,"/>
				</expression>
				<expression tag="String.Text" Value="which are executed without the reducers of their subexpressions having been executed; in fact these are never invoked by the reduction engine. If the reducer wants to invoke the reduction process on some or all of its subexpressions, it must do so itself. Likewise, the reducer may decide not to call reduction on any of its subexpressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="An example of a special reducer is presented below."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A symbol can have an associated value; let us say that the symbol"/>
				<expression tag="Symbolic.Symbol" Name="x"/>
				<expression tag="String.Text" Value="has the value 5 associated with it; then any occurrence of the symbol is replaced by the value associated with it."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Math.Arithmetic.Addition">
			<expression tag="Math.Number" Value="3"/>
			<expression tag="Symbolic.Symbol" Name="x"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="1">
		<expression tag="Math.Number" Value="8"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Math.Arithmetic.Division">
			<expression tag="Math.Arithmetic.Addition">
				<expression tag="Symbolic.Symbol" Name="x"/>
				<expression tag="Math.Number" Value="1"/>
			</expression>
			<expression tag="Math.Number" Value="2"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="1">
		<expression tag="Math.Number" Value="3"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Now, if we want to set a different value for it, we use an assignment expression:"/>
			</expression>
			<expression tag="Symbolic.Assignment">
				<expression tag="Symbolic.Symbol" Name="x"/>
				<expression tag="Math.Number" Value="12.5"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If the assignment reducer were normal (not special), and therefore the subexpressions were reduced first, the first step in reduction would be:"/>
			</expression>
			<expression tag="Symbolic.Assignment">
				<expression tag="Math.Number" Value="5"/>
				<expression tag="Math.Number" Value="12.5"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Which makes no sense. For this reason, the assignment reducer must be special. This reducer must also validate that the left-hand side of the assignment is valid, for example that it is a symbol. On the other hand, that reducer must indeed reduce the right-hand side of the assignment."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="If a (special) reducer needs to reduce one of its subexpressions, it can do so through the following methods:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="async ReductionSession.reduce(expression)"/>
					</expression>
					<expression tag="String.Text" Value="reduces the given expression. It returns no values."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The method"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="async ReductionSession.reduceAndGet(expression, index)"/>
					</expression>
					<expression tag="String.Text" Value="reduces the given expression. It is necessary to provide the subexpression number. It returns the already-reduced expression."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Because these methods are asynchronous, they are normally called with the keyword"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="await"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Priority and order of application of reducers"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are three reducer priority groups: high, normal, and low, which define the order in which they will be invoked (for the same tag). Within each group, the order in which they are invoked is the order in which they were registered in the reduction engine."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Reducers can come from various packages. Being able to set high (or low) priority for a reducer helps ensure that that reducer will run before (or after) the normal-priority ones, regardless of the packages (or rather) the order in which the packages were loaded."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For example, if the following reducers (for the same tag) are registered in the following order:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="R1, low priority"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="R2, high priority"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="R3, normal priority"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="R4, high priority"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The order in which they will be invoked will be R2, R4, R3, R1"/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Registering a reducer in the reduction engine."/>
				</expression>
				<expression tag="String.Text" Value="To add a reducer, you must make a call to the following method:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ReductionManager.addReducer(tag, reductionClass, description, [options])"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Where:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="tag"/>
					</expression>
					<expression tag="String.Text" Value="is the tag to which the reducer will be associated."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="reductionClass"/>
					</expression>
					<expression tag="String.Text" Value="is the reducer class."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="description"/>
					</expression>
					<expression tag="String.Text" Value="is an informational string."/>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="options"/>
						</expression>
						<expression tag="String.Text" Value="is an object, not mandatory, used to define the following options:"/>
					</expression>
					<expression tag="Typesetting.BulletedList">
						<expression tag="Typesetting.Paragraph">
							<expression tag="String.Text" Value="The"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="special"/>
							</expression>
							<expression tag="String.Text" Value="attribute can take a boolean value"/>
							<expression tag="String.Text" Value="that will indicate whether the reducer is special. Its default value is"/>
							<expression tag="Logic.False"/>
						</expression>
						<expression tag="Typesetting.Paragraph">
							<expression tag="String.Text" Value="The"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="precedence"/>
							</expression>
							<expression tag="String.Text" Value="attribute can take the values"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="ReductionManager.PRECEDENCE_HIGH"/>
							</expression>
							<expression tag="String.Text" Value=","/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="ReductionManager.PRECEDENCE_NORMAL"/>
							</expression>
							<expression tag="String.Text" Value="or"/>
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="ReductionManager.PRECEDENCE_LOW"/>
							</expression>
							<expression tag="String.Text" Value=", to indicate high, normal (the default value), or low precedence."/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As an example, the following code is used to add a special reducer to the engine, with low precedence:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="ReductionManager.addReducer(&quot;Math.Arithmetic.Addition&quot;, additionClass, &quot;Addition&quot;, { special: true, precedence: ReductionManager.PRECEDENCE_LOW });"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Registering the reducers that make up the package"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As already seen in the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Introduction" Description="introduction,"/>
				<expression tag="String.Text" Value="the definition of the reducer classes is placed in a source file named"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="reduction.js"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The general structure of this file is:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="reduction.js"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="export class ArithmeticPackage extends Formulae.ReductionPackage {};&#10;&#10;const addition = async (addition, session) =&gt; {&#10;&#9;:&#10;};&#10;&#10;const multiplication = async (multiplication, session) =&gt; {&#10;&#9;:&#10;};&#10;&#10;const division = async (division, session) =&gt; {&#10;&#9;:&#10;};&#10;&#10;ArithmeticPackage.setReducers = () =&gt; {&#10;&#9;ReductionManager.addReducer(&quot;Math.Arithmetic.Addition&quot;,       addition,       &quot;ArithmeticPackage.addition&quot;);&#10;&#9;ReductionManager.addReducer(&quot;Math.Arithmetic.Multiplication&quot;, multiplication, &quot;ArithmeticPackage.multiplication&quot;);&#10;&#9;ReductionManager.addReducer(&quot;Math.Arithmetic.Division&quot;,       division,       &quot;ArithmeticPackage.division&quot;);&#10;};"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The first part is the definition of the class that will represent our package, with respect to the reducers it contains. The class must extend the base class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.ReductionPackage"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Next, the definitions of the package's reducer classes are included."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Finally, there must be the definition (in fact the rewriting) of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="setReducers()"/>
				</expression>
				<expression tag="String.Text" Value="of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.ReductionPackage"/>
				</expression>
				<expression tag="String.Text" Value="(which originally does nothing). This method will be invoked by the framework each time the package is loaded for the first time. This method contains the calls to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.addReducer(tag, reductionClass, description)"/>
				</expression>
				<expression tag="String.Text" Value="seen in the previous section."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781784000000"/>
			</expression>
		</expression>
	</expression>
</expression>