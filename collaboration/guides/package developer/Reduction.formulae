<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.math.arithmetic,org.formulae.visualization,org.formulae.internet,org.formulae.diagramming,org.formulae.logic,org.formulae.math.complex,org.formulae.symbolic,org.formulae.list,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Reduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Reduction refers to the rules for transforming an expression (or part of it) into another."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The following example may seem trivial, but it reflects reduction in a very simple way. The expression"/>
				<expression tag="Math.Arithmetic.Addition">
					<expression tag="Math.Number" Value="2"/>
					<expression tag="Math.Number" Value="3"/>
				</expression>
				<expression tag="String.Text" Value="is transformed into the expression"/>
				<expression tag="Math.Number" Value="5"/>
				<expression tag="String.Text" Value="because there is a reducer that transforms the first expression into the second, obeying a simple rule, that of arithmetic addition."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Despite the name &quot;reduction&quot;, the new expression need not necessarily be smaller, but more useful or simpler."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Session"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Once an expression is created and you want it to be &quot;executed&quot;, you press the"/>
				<expression tag="Visualization.Key">
					<expression tag="String.Text" Value="ENTER"/>
				</expression>
				<expression tag="String.Text" Value="key. From that moment until the system delivers the &quot;result&quot;, it is said to be a reduction session, or simply a session. A session keeps the following set of parameters that affect execution:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A reference to a string representing the"/>
					<expression tag="Internet.Hyperlink" Value="https://es.wikipedia.org/wiki/Configuraci%C3%B3n_regional" Description="&quot;locale&quot; or regional settings,"/>
					<expression tag="String.Text" Value="for example"/>
					<expression tag="String.String" Value="es-MX"/>
					<expression tag="String.Text" Value="to refer to the Spanish language in Mexico."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A reference to a string representing the time zone, for example"/>
					<expression tag="String.String" Value="America/Mexico_City"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="An integer that indicates the precision, for performing numerical calculations."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A rounding type, for performing numerical calculations."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A flag that indicates whether numerical calculations will be performed with normal or arbitrary precision."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="All of them (except the last) can be changed during execution."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Reducers"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A reducer is a piece of code that is associated with a"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag."/>
				</expression>
				<expression tag="String.Text" Value="The code is responsible for analyzing the expression to see if it meets the conditions for it to be transformed into another expression, and doing so if they are met."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Given a"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="there can be zero, one, or several reducers associated with it."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Reduction engine"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The reduction process is an algorithm for applying reducers to an expression, no matter how complex. It is also commonly called the &quot;reduction engine&quot;."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The idea of the reduction process is to apply the available reducers until there are no more reducers to apply. At that point the process concludes and the expression is delivered as the result."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Programming a reducer"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="A reducer must conform to the following form:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="name = async (expression, session) =&gt; {&#10;&#9;:&#10;&#9;&#10;&#9;it must always return a boolean value (true or false)&#10;};"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="That is, the reducer must meet the following:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Be a method marked as asynchronous."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Receive a first argument, which is a reference to the expression for which the reducer is being invoked."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Receive a second argument, which is a reference to the session."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="It must always return a boolean value, which indicates whether the reducer made changes to the expression or not."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Rules"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="When a reducer is invoked, the reduction of its subexpressions has already happened."/>
				</expression>
				<expression tag="String.Text" Value="The reduction engine first reduces the subexpressions of an expression, before invoking the reducers of that expression"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For example, see the following expression, shown in inverted-tree form. It must also be assumed that there are two reducers, one to perform the addition and another for the multiplication of numbers:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Multiplication"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Math.Number" Value="5"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="Addition"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Math.Number" Value="2"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Math.Number" Value="4"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The reduction engine ensures that the addition reducer will be invoked first, leaving the expression as:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Multiplication"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Math.Number" Value="5"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Math.Number" Value="6"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Then the multiplication reducer is invoked, leaving the tree as:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Math.Number" Value="30"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Since there are no more reducers to apply, the reduction ends."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="The reducer's code must first verify whether the expression is suitable for the intended reduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Generally, the association of the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="is not enough. Typically it is necessary to do that validation as early as possible and return the value"/>
				<expression tag="Logic.False"/>
				<expression tag="String.Text" Value="when it is determined that the reducer is not applicable."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As an example, consider a reducer to perform numerical addition. The reducer must first verify whether the subexpressions (the addends) are numbers."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Use the correct return value"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Remember that the return value means the expression has changed and is important for the reduction engine, since if a reducer does not apply to a given expression (does not change it), it will try another one or more (remember that a"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="can have several reducers associated). If the reducer actually changed the expression into a different one, it is important to return the value"/>
				<expression tag="Logic.True"/>
				<expression tag="String.Text" Value="so that the reduction engine does NOT try to apply other reducers."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Numerical calculations in reduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Data types for storing numbers"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As you have surely noticed, a number is an expression with the"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.Number"/>
				</expression>
				<expression tag="String.Text" Value="and that has internal state, which is either an object of type"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="BigInteger"/>
				</expression>
				<expression tag="String.Text" Value="(for storing integers) or of type"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="Decimal"/>
				</expression>
				<expression tag="String.Text" Value="(for storing decimal numbers)."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The rules governing the semantics of numbers are defined in the"/>
				<expression tag="Internet.Hyperlink" Value="?script=reference/Arithmetic_canon" Description="arithmetic canon"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="From that canon, the following information can be obtained:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="The numbers that can be stored in a"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="Math.Number"/>
					</expression>
					<expression tag="String.Text" Value="expression are NON-negative integer and decimal values."/>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Negative numbers can be created using the"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
						</expression>
						<expression tag="String.Text" Value="expression; in this way the expression"/>
						<expression tag="Math.Arithmetic.Negative">
							<expression tag="Math.Number" Value="5"/>
						</expression>
						<expression tag="String.Text" Value="can be created as:"/>
					</expression>
					<expression tag="Typesetting.Centering">
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Negative"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="5"/>
							</expression>
						</expression>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="There are no expressions to define rational numbers or complex numbers; however, the user can create them as combinations of expressions of type"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Number"/>
						</expression>
						<expression tag="String.Text" Value=","/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
						</expression>
						<expression tag="String.Text" Value=","/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Arithmetic.Division"/>
						</expression>
						<expression tag="String.Text" Value=","/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Arithmetic.Multiplication"/>
						</expression>
						<expression tag="String.Text" Value="and"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Complex.ImaginaryUnit"/>
						</expression>
						<expression tag="String.Text" Value=", for example the rational number"/>
						<expression tag="Math.Arithmetic.Division">
							<expression tag="Math.Number" Value="2"/>
							<expression tag="Math.Number" Value="3"/>
						</expression>
						<expression tag="String.Text" Value="is expressed as:"/>
					</expression>
					<expression tag="Typesetting.Centering">
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Division"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="2"/>
							</expression>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="3"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="While the complex number"/>
						<expression tag="Math.Arithmetic.Addition">
							<expression tag="Math.Number" Value="2.5"/>
							<expression tag="Math.Arithmetic.Negative">
								<expression tag="Math.Arithmetic.Multiplication">
									<expression tag="Math.Arithmetic.Division">
										<expression tag="Math.Number" Value="3"/>
										<expression tag="Math.Number" Value="5"/>
									</expression>
									<expression tag="Math.Complex.ImaginaryUnit"/>
								</expression>
							</expression>
						</expression>
						<expression tag="String.Text" Value="is expressed as:"/>
					</expression>
					<expression tag="Typesetting.Centering">
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Addition"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="2.5"/>
							</expression>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="String.Text" Value="Negative"/>
								<expression tag="Diagramming.Tree" Expanded="True">
									<expression tag="String.Text" Value="Multiplication"/>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="String.Text" Value="Division"/>
										<expression tag="Diagramming.Tree" Expanded="True">
											<expression tag="Math.Number" Value="3"/>
										</expression>
										<expression tag="Diagramming.Tree" Expanded="True">
											<expression tag="Math.Number" Value="5"/>
										</expression>
									</expression>
									<expression tag="Diagramming.Tree" Expanded="True">
										<expression tag="Math.Complex.ImaginaryUnit"/>
									</expression>
								</expression>
							</expression>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="However, the"/>
				<expression tag="Internet.Hyperlink" Value="?script=reference/Arithmetic_canon" Description="arithmetic canon"/>
				<expression tag="String.Text" Value="is a set of rules for forming expressions from the point of view of the end user, not of reduction."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Numerical expressions during reduction"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="During reduction, the numerical expressions and the way of organizing them vary slightly, in order to facilitate the representation and the very way of calculating numerical expressions."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="When the execution of an expression is invoked, starting reduction, the framework takes care of transforming the numerical expressions (and others) to the format required for reduction. Once reduction ends, the framework also takes care of transforming the resulting expression to the original format."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="1. In reduction, the expression"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.InternalNumber"/>
				</expression>
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="is used instead of"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.Number"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The internal value of a"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.InternalNumber"/>
				</expression>
				<expression tag="String.Text" Value="expression can be one of the following objects:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="An integer, represented by an object of the class"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="NumberI"/>
					</expression>
					<expression tag="String.Text" Value="or"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="BigInt,"/>
					</expression>
					<expression tag="String.Text" Value="depending on whether single or arbitrary precision is used respectively, and they can be positive, negative, or zero."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A decimal number, represented by an object of the class"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="NumberD"/>
					</expression>
					<expression tag="String.Text" Value="or"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="Decimal,"/>
					</expression>
					<expression tag="String.Text" Value="depending on whether single or arbitrary precision is used respectively, and they can be positive, negative, or zero."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A rational number, which is stored internally as two integer objects, one for the numerator and another for the denominator. They can be negative or positive. The denominator cannot be zero."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A complex number, which is stored internally as two objects of integer, decimal, or rational type, one for the real part and another for the imaginary part. The imaginary part cannot be zero."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="2. In reduction, there is no expression"/>
				</expression>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.Arithmetic.Negative"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="During reduction, the arithmetic negative expression does not exist, since any expression of the form"/>
				<expression tag="Math.Arithmetic.Negative">
					<expression tag="Symbolic.Symbol" Name="expression"/>
				</expression>
				<expression tag="String.Text" Value="represented as:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Negative"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Symbolic.Symbol" Name="expression"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Is transformed into the expression:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Multiplication"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="(-1)"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Symbolic.Symbol" Name="expression"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Where the expression"/>
				<expression tag="String.Text" Value="(-1)"/>
				<expression tag="String.Text" Value="has the tag"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.InternalNumber"/>
				</expression>
				<expression tag="String.Text" Value="and therefore accepts negative values"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Each time a reduction process starts, the framework transforms the aforementioned expressions to their corresponding form for the reduction process. Once the reduction process has concluded, the reverse process begins."/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="List.Table">
					<expression tag="List.List">
						<expression tag="List.List">
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Expression"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="In inverted-tree format"/>
							</expression>
							<expression tag="Visualization.Bold" Value="True" Set="True">
								<expression tag="String.Text" Value="Converted for reduction"/>
							</expression>
						</expression>
						<expression tag="List.List">
							<expression tag="Math.Number" Value="5"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Visualization.HorizontalArray">
									<expression tag="Visualization.Code">
										<expression tag="String.Text" Value="Math.Number"/>
									</expression>
									<expression tag="Visualization.Parentheses">
										<expression tag="Math.Number" Value="5"/>
