			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;&quot;pathMorse&quot;: &quot;Código Morse&quot;,&#10;&#9;&quot;nameDot&quot;: &quot;Punto&quot;,&#10;&#9;&quot;mnemonicDot&quot;: &quot;punto&quot;,&#10;&#9;&quot;literalDot&quot;: &quot;·&quot;,&#10;&#9;&quot;leafDot&quot;: &quot;· Punto&quot;,&#10;&#9;&quot;nameDash&quot;: &quot;Raya&quot;,&#10;&#9;&quot;mnemonicDash&quot;: &quot;raya&quot;,&#10;&#9;&quot;literalDash&quot;: &quot;−&quot;,&#10;&#9;&quot;leafDash&quot;: &quot;− Raya&quot;,&#10;&#9;&quot;nameInterLetter&quot;: &quot;Entre letras&quot;,&#10;&#9;&quot;mnemonicInterLetter&quot;: &quot;entreLetras&quot;,&#10;&#9;&quot;literalInterLetter&quot;: &quot;|&quot;,&#10;&#9;&quot;leafInterLetter&quot;: &quot;| Entre letras&quot;,&#10;&#9;&quot;nameInterWord&quot;: &quot;Entre palabras&quot;,&#10;&#9;&quot;mnemonicInterWord&quot;: &quot;entrePalabras&quot;,&#10;&#9;&quot;literalInterWord&quot;: &quot;‖&quot;,&#10;&#9;&quot;leafInterWord&quot;: &quot;‖ Entre palabras&quot;,&#10;&#9;&quot;nameMessage&quot;: &quot;Mensaje&quot;,&#10;&#9;&quot;mnemonicMessage&quot;: &quot;mensaje&quot;,&#10;&#9;&quot;childrenMessage&quot;: [&quot;Símbolo&quot;],&#10;&#9;&quot;leafMessage&quot;: &quot;Mensaje&quot;,&#10;&#9;&quot;nameTextToMorse&quot;: &quot;Texto a Morse&quot;,&#10;&#9;&quot;mnemonicTextToMorse&quot;: &quot;textoAMorse&quot;,&#10;&#9;&quot;childrenTextToMorse&quot;: [&quot;Texto&quot;],&#10;&#9;&quot;leafTextToMorse&quot;: &quot;Texto → Morse&quot;,&#10;&#9;&quot;nameMorseToText&quot;: &quot;Morse a Texto&quot;,&#10;&#9;&quot;mnemonicMorseToText&quot;: &quot;morseATexto&quot;,&#10;&#9;&quot;childrenMorseToText&quot;: [&quot;Mensaje&quot;],&#10;&#9;&quot;leafMorseToText&quot;: &quot;Morse → Texto&quot;,&#10;&#9;&quot;errorInvalidChar&quot;: &quot;El carácter '{0}' no se puede codificar en Morse&quot;,&#10;&#9;&quot;errorInvalidSequence&quot;: &quot;Secuencia Morse inválida: {0}&quot;,&#10;&#9;&quot;errorEmpty&quot;: &quot;mensaje vacío&quot;,&#10;&#9;&quot;errorMustStart&quot;: &quot;debe comenzar con un símbolo (punto o raya)&quot;,&#10;&#9;&quot;errorMustEnd&quot;: &quot;debe terminar con un símbolo (punto o raya)&quot;,&#10;&#9;&quot;errorConsecutiveSymbols&quot;: &quot;símbolos consecutivos sin separador en la posición {0}&quot;,&#10;&#9;&quot;errorConsecutiveSeparators&quot;: &quot;separadores consecutivos en la posición {0}&quot;,&#10;&#9;&quot;errorUnknownPattern&quot;: &quot;patrón de letra desconocido: {0}&quot;,&#10;&#9;&quot;errorInvalidStructure&quot;: &quot;estructura inválida&quot;&#10;}&#10;"/>
			<expression tag="Typesetting.Paragraph">
