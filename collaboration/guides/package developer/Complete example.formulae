			<expression tag="Visualization.CodeBlock" Value="{&#10;&#9;&quot;pathMorse&quot;: &quot;Morse&quot;,&#10;&#9;&quot;nameDot&quot;: &quot;Dot&quot;,&#10;&#9;&quot;mnemonicDot&quot;: &quot;dot&quot;,&#10;&#9;&quot;literalDot&quot;: &quot;·&quot;,&#10;&#9;&quot;leafDot&quot;: &quot;· Dot&quot;,&#10;&#9;&quot;nameDash&quot;: &quot;Dash&quot;,&#10;&#9;&quot;mnemonicDash&quot;: &quot;dash&quot;,&#10;&#9;&quot;literalDash&quot;: &quot;−&quot;,&#10;&#9;&quot;leafDash&quot;: &quot;− Dash&quot;,&#10;&#9;&quot;nameInterLetter&quot;: &quot;Inter-letter&quot;,&#10;&#9;&quot;mnemonicInterLetter&quot;: &quot;interLetter&quot;,&#10;&#9;&quot;literalInterLetter&quot;: &quot;|&quot;,&#10;&#9;&quot;leafInterLetter&quot;: &quot;| Inter-letter&quot;,&#10;&#9;&quot;nameInterWord&quot;: &quot;Inter-word&quot;,&#10;&#9;&quot;mnemonicInterWord&quot;: &quot;interWord&quot;,&#10;&#9;&quot;literalInterWord&quot;: &quot;‖&quot;,&#10;&#9;&quot;leafInterWord&quot;: &quot;‖ Inter-word&quot;,&#10;&#9;&quot;nameMessage&quot;: &quot;Message&quot;,&#10;&#9;&quot;mnemonicMessage&quot;: &quot;message&quot;,&#10;&#9;&quot;childrenMessage&quot;: [&quot;Symbol&quot;],&#10;&#9;&quot;leafMessage&quot;: &quot;Message&quot;,&#10;&#9;&quot;nameTextToMorse&quot;: &quot;Text to Morse&quot;,&#10;&#9;&quot;mnemonicTextToMorse&quot;: &quot;textToMorse&quot;,&#10;&#9;&quot;childrenTextToMorse&quot;: [&quot;Text&quot;],&#10;&#9;&quot;leafTextToMorse&quot;: &quot;Text → Morse&quot;,&#10;&#9;&quot;nameMorseToText&quot;: &quot;Morse to Text&quot;,&#10;&#9;&quot;mnemonicMorseToText&quot;: &quot;morseToText&quot;,&#10;&#9;&quot;childrenMorseToText&quot;: [&quot;Message&quot;],&#10;&#9;&quot;leafMorseToText&quot;: &quot;Morse → Text&quot;,&#10;&#9;&quot;errorInvalidChar&quot;: &quot;Character '{0}' cannot be encoded in Morse&quot;,&#10;&#9;&quot;errorInvalidSequence&quot;: &quot;Invalid Morse sequence: {0}&quot;,&#10;&#9;&quot;errorEmpty&quot;: &quot;empty message&quot;,&#10;&#9;&quot;errorMustStart&quot;: &quot;must start with a symbol (dot or dash)&quot;,&#10;&#9;&quot;errorMustEnd&quot;: &quot;must end with a symbol (dot or dash)&quot;,&#10;&#9;&quot;errorConsecutiveSymbols&quot;: &quot;consecutive symbols without separator at position {0}&quot;,&#10;&#9;&quot;errorConsecutiveSeparators&quot;: &quot;consecutive separators at position {0}&quot;,&#10;&#9;&quot;errorUnknownPattern&quot;: &quot;unknown letter pattern: {0}&quot;,&#10;&#9;&quot;errorInvalidStructure&quot;: &quot;invalid structure&quot;&#10;}&#10;"/>
