				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Summary"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Though it fits in a few small files, the Morse package is a complete, self-contained Fōrmulæ package. It demonstrates:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="expression.js"/>
					</expression>
					<expression tag="String.Text" Value="— nullary, variadic, and function expression types; the compact spec-object form alongside a full custom-rendering class; accent colors; and inherited keyboard traversal."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="edition.js"/>
					</expression>
					<expression tag="String.Text" Value="— the replacing, multiple, and wrapper edition helpers, and a menu hierarchy."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="reduction.js"/>
					</expression>
					<expression tag="String.Text" Value="— two reducers, reducing children, type checks, building result trees, and error reporting."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="i18n/"/>
					</expression>
					<expression tag="String.Text" Value="— fully localized labels and error messages, with non-text data kept out of the message files."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Use it as a template: copy the directory, rename the package and its tags, and replace the four modules with your own domain."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
