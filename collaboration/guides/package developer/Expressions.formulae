<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.visualization,org.formulae.internet,org.formulae.math.arithmetic,org.formulae.symbolic,org.formulae.diagramming,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Developer's guide"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Defining expressions"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="An expression is an abstraction that contains the following basic attributes:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A string, called the &quot;Tag&quot;, that defines the type of expression."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="A collection of zero, one, or several subexpressions."/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Every expression must be an object of a class derived from the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression."/>
				</expression>
				<expression tag="String.Text" Value="This class has many attributes and methods, which will be explained gradually."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Methods related to the definition of the expression"/>
				</expression>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getTag()"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return the"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="tag"/>
						</expression>
						<expression tag="String.Text" Value="of the expression. The tag is a string of the form"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Field.SubField.SubSubField. ... .Expression"/>
						</expression>
						<expression tag="String.Text" Value="(words separated by dots). The words are English names, and except for the last one they are the names of the field, subfield, subsubfield, etc. of the science, and the last name is that of the expression. For example, arithmetic addition has the tag"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Arithmetic.Addition."/>
						</expression>
						<expression tag="String.Text" Value="The words are always capitalized, with no spaces or special characters. If a name requires several words, it is formed in a"/>
						<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Camel_case" Description="CamelCase"/>
						<expression tag="String.Text" Value="that is, each word is capitalized and connecting words such as &quot;of&quot;, &quot;for&quot;, etc. are not used, for example"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="Math.Complex.ImaginaryUnit"/>
						</expression>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getName()"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return a string with the descriptive name of the expression. An example would be &quot;Arithmetic addition&quot;."/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Methods related to the definition of subexpressions"/>
				</expression>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="canHaveChildren(count)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return a boolean value indicating whether the number of subexpressions provided as input is valid for the expression. For example, if an expression is a strictly binary operation, such as a division or exponentiation, the only value for which it would return true is"/>
						<expression tag="Math.Number" Value="2"/>
						<expression tag="String.Text" Value="."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getChildName(index)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return the name of the subexpression referenced by its index or position. If the expression contains no subexpressions, it is not necessary to implement this method, since it will never be called."/>
					</expression>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Examples"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Based on what we have seen so far, an expression to represent arithmetic addition would be as follows. It is understood that a sum cannot have zero or a single addend. Moreover, all its subexpressions receive the same name: &quot;Addend&quot;:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Addition = class extends Expression {&#10;&#9;getTag() {&#10;&#9;&#9;return &quot;Math.Arithmetic.Addition&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;getName() {&#10;&#9;&#9;return &quot;Arithmetic addition&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;canHaveChildren(count) {&#10;&#9;&#9;return count &gt;= 2;&#10;&#9;}&#10;&#9;&#10;&#9;getChildName(index) {&#10;&#9;&#9;return &quot;Addend&quot;;&#10;&#9;}&#10;}"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Now let us look at the case of a division, which can have two and only two subexpressions, which receive different names:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Division = class extends Expression {&#10;&#9;getTag() {&#10;&#9;&#9;return &quot;Math.Arithmetic.Division&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;getName() {&#10;&#9;&#9;return &quot;Arithmetic division&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;canHaveChildren(count) {&#10;&#9;&#9;return count == 2;&#10;&#9;}&#10;&#9;&#10;&#9;getChildName(index) {&#10;&#9;&#9;return index == 0 ? &quot;Dividend&quot; : &quot;Divisor&quot;;&#10;&#9;}&#10;}"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Existing properties"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value="has several already-defined properties, which therefore become common to any expression:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The property"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="children"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="It is an array of references to objects derived from subclasses of the class"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Expression"/>
						</expression>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The property"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parent"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="It is a reference to the parent expression. It may have an undefined value if the current expression is not a subexpression of another."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The property"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="index"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="It is the subexpression number relative to its parent expression, if it has one."/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="These properties are shown for informational purposes. The expression programmer's code may use them read-only, but it is not intended to modify them directly, since inconsistent situations can arise, for example an expression X having a subexpression that does not reference X as its parent expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Methods for manipulating subexpressions"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value="has several existing methods for manipulating subexpressions. These methods manipulate the properties"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="parent"/>
				</expression>
				<expression tag="String.Text" Value="and"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="child"/>
				</expression>
				<expression tag="String.Text" Value="of the expressions involved so that they remain in a consistent state."/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="setChild(index, child)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method replaces the subexpression (referenced by position) of the current expression with the expression passed as an argument."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="addChild(child)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method inserts a subexpression at the end of the existing subexpressions."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="addChildAt(index, child)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method inserts a subexpression at the position indicated as an argument. This number indicates the position the provided subexpression will occupy. The value can range from zero (at the start) to"/>
						<expression tag="Symbolic.Symbol" Name="n"/>
						<expression tag="String.Text" Value="(at the end) if the current expression has"/>
						<expression tag="Symbolic.Symbol" Name="n"/>
						<expression tag="String.Text" Value="subexpressions."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="removeChildAt(index)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method removes the subexpression referenced by position. The subexpression is not deleted, only &quot;disconnected&quot; as a subexpression of the current expression, so it becomes &quot;orphaned&quot;, that is, it is no longer a subexpression of any expression. It returns a reference to the disconnected subexpression."/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Other methods of interest"/>
				</expression>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="clone()"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method creates a copy of the current expression. The subexpressions are in turn duplicated (deep copy). The result is an expression identical to the original, except that the property"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parent"/>
						</expression>
						<expression tag="String.Text" Value="of its root expression is left null, so it is an &quot;orphaned&quot; expression."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="replaceBy(replacer)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method causes the current expression to be &quot;disconnected&quot; from the expression it belongs to (that is, it is disconnected from its parent), to be replaced by the expression specified as an argument. Note that this method can only work if the current expression has a non-null value for the property"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="parent"/>
						</expression>
						<expression tag="String.Text" Value="."/>
					</expression>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ExpressionHandler"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="replaceBy(replacer)"/>
				</expression>
				<expression tag="String.Text" Value="is widely used, mainly for reduction (the transformation of expressions into other expressions); for example, the expression"/>
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="String.Text" Value="Addition"/>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Math.Number" Value="2"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Math.Number" Value="3"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="can be reduced to the expression"/>
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Math.Number" Value="5"/>
				</expression>
				<expression tag="String.Text" Value=", however, a call cannot be made to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="replaceBy(replacer)"/>
				</expression>
				<expression tag="String.Text" Value="of the addition expression, since it has no parent expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ExpressionHandler"/>
				</expression>
				<expression tag="String.Text" Value="acts as a wildcard expression, so that the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="replaceBy(replacer)"/>
				</expression>
				<expression tag="String.Text" Value="can now be applied to any of the expressions and subexpressions, since they all have a parent expression."/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Visualization.HorizontalArray">
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="Handler"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="String.Text" Value="Addition"/>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="2"/>
							</expression>
							<expression tag="Diagramming.Tree" Expanded="True">
								<expression tag="Math.Number" Value="3"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Visualization.FontSize" Size="32">
						<expression tag="String.Text" Value=" ➡ "/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="String.Text" Value="Handler"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Math.Number" Value="5"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It is recommended, for the sake of order, that whenever you have to manage a set of expressions, you always use an object of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="ExpressionHandler"/>
				</expression>
				<expression tag="String.Text" Value="for each of them."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Expressions with"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="internal values"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are expressions that, even having the same"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="can take on a finite or infinite number of entities. A typical case is numbers, which although they share the tag"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Math.Number"/>
				</expression>
				<expression tag="String.Text" Value="one object can be used to represent the number 48, and another for the number 12.5, and they are considered different. Each object of this type also stores the number itself, as an entity of the underlying language."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Some examples of other expressions of this type are:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Expressions that represent strings, which store the actual string represented in the implementation language."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Expressions that represent dates, which internally store the date in the data type of the implementation language."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In order for an expression to support internal values, one (or several)"/>
				<expression tag="Visualization.Italic" Value="True" Set="True">
					<expression tag="String.Text" Value="attributes"/>
				</expression>
				<expression tag="String.Text" Value="must be defined, and the following methods must also be implemented:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="set(name, value)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method sets the given value for the attribute specified by the argument"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="name"/>
						</expression>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="get(name)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method returns the value associated with the specified argument"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Number = class extends Expression {&#10;&#9;getTag() {&#10;&#9;&#9;return &quot;Math.Number&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;getName() {&#10;&#9;&#9;return &quot;Number&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;canHaveChildren(count) {&#10;&#9;&#9;return count == 0;&#10;&#9;}&#10;&#9;&#10;&#9;set(name, value) {&#10;&#9;&#9;if (name === &quot;Value&quot;) {&#10;&#9;&#9;&#9;this.number = value;&#10;&#9;&#9;}&#10;&#9;&#9;else {&#10;&#9;&#9;&#9;super.set(name, value);&#10;&#9;&#9;}&#10;&#9;}&#10;&#9;&#10;&#9;get(name) {&#10;&#9;&#9;if (name === &quot;Value&quot;) {&#10;&#9;&#9;&#9;return this.number;&#10;&#9;&#9;}&#10;&#9;&#9;else {&#10;&#9;&#9;&#9;return super.get(name);&#10;&#9;&#9;}&#10;&#9;}&#10;&#9;&#10;&#9;:&#10;}"/>
			<expression tag="Visualization.CodeBlock" Value="let numberExpression = ...                    // we haven't seen how to create expressions yet&#10;&#10;numberExpression.set(&quot;Value&quot;, 5.25);          // set the number on the expression&#10;&#10;console.log(numberExpression.get(&quot;Value&quot;));   // should display 5.25"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Serialization/deserialization of expressions"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Serialization refers to the conversion of entities (for example objects) into a form that can be stored and transported, typically as strings. The reverse process is known as"/>
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="deserialization."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For expressions that do not have internal values, the framework is able to serialize and deserialize them automatically."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For expressions with internal values, it is necessary to convert the internal state of the expression into one or more strings, referenced by name, and vice versa (convert from strings to internal state). These strings do not necessarily have to correspond to the attributes of the internal values, although it is common for them to do so."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method for converting internal state to/from strings must be clear, simple, and not depend on region or language factors; in other words, it must be a"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Pure_function" Description="pure function."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Once the conversion method is defined, the following methods must be implemented:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getSerializationNames()"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return an array of strings that defines the names of the serialization strings. It must contain at least one string."/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="async getSerializationStrings()"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method must return a promise that will resolve with an array of strings, containing the serialization strings that define the internal state of the expression. The order in which the strings appear must be the same as that provided by the method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getSerializationNames()"/>
						</expression>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="setSerializationStrings(strings, promises)"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="This method creates the internal state of the expression from an array of strings; that is, it provides deserialization. The order in which the strings appear must be the same as that provided by the method"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="getSerializationNames()."/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="The method also receives an array of promises. The purpose of this array is so that the method can add promises to it"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Example."/>
				</expression>
				<expression tag="String.Text" Value="Suppose we want to create the expression for a date (with time), that is, a point in time. The expression must maintain a value internally to hold that time."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="There are several ways to convert a date object to a string; among the most appropriate are:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Use the standard"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/ISO_8601" Description="ISO 8601."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Use the number of milliseconds elapsed since a reference point in time, for example since a recognized"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Epoch_(computing)" Description="epoch,"/>
					<expression tag="String.Text" Value="(for example the one used in"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Unix" Description="Unix"/>
					<expression tag="String.Text" Value="for a preset time zone, for example"/>
					<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/Coordinated_Universal_Time" Description="UTC"/>
					<expression tag="String.Text" Value=")."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For the example, the last one was used:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Time = class extends Expression {&#10;&#9;getTag() {&#10;&#9;&#9;return &quot;Time.Time&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;getName() {&#10;&#9;&#9;return &quot;Time&quot;;&#10;&#9;}&#10;&#9;&#10;&#9;canHaveChildren(count) {&#10;&#9;&#9;return count == 0;&#10;&#9;}&#10;&#9;&#10;&#9;set(name, value) {&#10;&#9;&#9;if (name === &quot;Value&quot;) {&#10;&#9;&#9;&#9;this.date = value;&#10;&#9;&#9;}&#10;&#9;&#9;else {&#10;&#9;&#9;&#9;super.set(name, value);&#10;&#9;&#9;}&#10;&#9;}&#10;&#9;&#10;&#9;get(name) {&#10;&#9;&#9;if (name === &quot;Value&quot;) {&#10;&#9;&#9;&#9;return this.date;&#10;&#9;&#9;}&#10;&#9;&#9;else {&#10;&#9;&#9;&#9;return super.get(name);&#10;&#9;&#9;}&#10;&#9;}&#10;&#9;&#10;&#9;getSerializationNames() {&#10;&#9;&#9;return [ &quot;Value&quot; ];&#10;&#9;}&#10;&#9;&#10;&#9;async getSerializationStrings() {&#10;&#9;&#9;return [ this.date.getTime().toString() ];&#10;&#9;}&#10;&#9;&#10;&#9;setSerializationStrings(strings, promises) {&#10;&#9;&#9;this.date = new Date(Number(strings[0]));&#10;&#9;}&#10;}"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The format in which serialization is performed is defined by the framework; typically it is"/>
				<expression tag="Internet.Hyperlink" Value="https://en.wikipedia.org/wiki/XML" Description="XML"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="In this way, the following expression (the next chapter will show how to code the visualization of expressions), which is displayed as:"/>
			</expression>
			<expression tag="Time.Time" Value="1737435120000"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It will be serialized as:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="&lt;expression tag=&quot;Time.Time&quot; Value=&quot;1737435120000&quot;/&gt;"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As a second example, the following expression:"/>
			</expression>
			<expression tag="Math.Arithmetic.Addition">
				<expression tag="Math.Number" Value="3"/>
				<expression tag="Math.Arithmetic.Division">
					<expression tag="Math.Number" Value="2"/>
					<expression tag="Math.Number" Value="5"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="It is serialized as:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="&lt;expression tag=&quot;Math.Arithmetic.Addition&quot;&gt;&#10;&#9;&lt;expression tag=&quot;Math.Number&quot; Value=&quot;3&quot;/&gt;&#10;&#9;&lt;expression tag=&quot;Math.Arithmetic.Division&quot;&gt;&#10;&#9;&#9;&lt;expression tag=&quot;Math.Number&quot; Value=&quot;2&quot;/&gt;&#10;&#9;&#9;&lt;expression tag=&quot;Math.Number&quot; Value=&quot;5&quot;/&gt;&#10;&#9;&lt;/expression&gt;&#10;&lt;/expression&gt;"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Class templates"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The classes for creating new expressions are rarely derived from the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Expression"/>
				</expression>
				<expression tag="String.Text" Value=". There are template classes that contain common functionality for new subclasses."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="These class templates are the following:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="Expression.FixedExpression = class extends Expression {&#10;&#9;canInsertChildAt(index) { return false; }&#10;&#9;canRemoveChildAt(index) { return false; }&#10;}&#10;&#10;Expression.NullaryExpression = class extends Expression.FixedExpression {&#10;&#9;canHaveChildren(count) { return count == 0; }&#10;&#9;isReduced() { return true; }&#10;}&#10;&#10;Expression.UnaryExpression = class extends Expression.FixedExpression {&#10;&#9;canHaveChildren(count) { return count == 1; }&#10;}&#10;&#10;Expression.BinaryExpression = class extends Expression.FixedExpression {&#10;&#9;canHaveChildren(count) { return count == 2; }&#10;}&#10;&#10;Expression.OperatorExpression = class extends Expression {&#10;&#9;canHaveChildren(count)  { return count &gt;= 2; }&#10;}"/>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Class factory"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The creation of expressions is done through a"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="class factory."/>
				</expression>
				<expression tag="String.Text" Value="The purpose of this class factory is to be able to create expressions based only on their"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="tag"/>
				</expression>
				<expression tag="String.Text" Value="regardless of which package they come from."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.setExpression(module, tag, expressionClass)"/>
				</expression>
				<expression tag="String.Text" Value="registers the class of the argument"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="expressionClass"/>
				</expression>
				<expression tag="String.Text" Value="in the class factory, so that it returns an expression of that class when invoked with the indicated tag."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Registering the expressions that make up the package"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As already seen in the section on"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Preparation" Description="preparation,"/>
				<expression tag="String.Text" Value="the definition of classes that describe the expressions is placed in a source file named"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="expression.js"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The general structure of this file is:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="expression.js"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="export class ArithmeticPackage extends Formulae.ExpressionPackage {};&#10;&#10;const Number = class ... {&#10;&#9;:&#10;};&#10;&#10;const Addition = class ... {&#10;&#9;:&#10;};&#10;&#10;const Multiplication = class ... {&#10;&#9;:&#10;};&#10;&#10;ArithmeticPackage.setExpressions = function(module) {&#10;&#9;Formulae.setExpression(module, &quot;Math.Number&quot;,                    Number);&#10;&#9;Formulae.setExpression(module, &quot;Math.Arithmetic.Addition&quot;,       Addition);&#10;&#9;Formulae.setExpression(module, &quot;Math.Arithmetic.Multiplication&quot;, Multiplication);&#10;&#9;:&#10;};"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The first part is the definition of the class that will represent our package, with respect to the definition of expressions it contains. The class must extend the base class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.ExpressionPackage"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Next, the definitions of the classes that represent the package's expressions are included."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Finally, there must be the definition (in fact the rewriting) of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="setExpressions(module)"/>
				</expression>
				<expression tag="String.Text" Value="of the class"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.ExpressionPackage"/>
				</expression>
				<expression tag="String.Text" Value="(which originally does nothing). This method will be invoked by the framework each time the package is loaded for the first time. This method contains the calls to the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.setExpression(module, tag, expressionClass)"/>
				</expression>
				<expression tag="String.Text" Value="seen in the previous section."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Creating expressions"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="The creation of expressions is not done using the operator"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="new"/>
				</expression>
				<expression tag="String.Text" Value=", since that would force hard-coding the class that will represent a given expression."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="As already seen, the creation of expressions is done through the class factory."/>
				<expression tag="String.Text" Value="This is done by means of the method"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="Formulae.createExpression(tag, ...children)"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="For example, the code to create the expression from the previous example"/>
				<expression tag="Math.Arithmetic.Addition">
					<expression tag="Math.Number" Value="3"/>
					<expression tag="Math.Arithmetic.Division">
						<expression tag="Math.Number" Value="2"/>
						<expression tag="Math.Number" Value="5"/>
					</expression>
				</expression>
				<expression tag="String.Text" Value="could be:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="let n3 = Formulae.createExpression(&quot;Math.Number&quot;); n3.set(&quot;Value&quot;, 3);&#10;let n2 = Formulae.createExpression(&quot;Math.Number&quot;); n2.set(&quot;Value&quot;, 2);&#10;let n5 = Formulae.createExpression(&quot;Math.Number&quot;); n5.set(&quot;Value&quot;, 5);&#10;&#10;let expression = Formulae.createExpression(&#10;&#9;&quot;Math.Arithmetic.Addition&quot;,&#10;&#9;n3,&#10;&#9;Formulae.createExpression(&#10;&#9;&#9;&quot;Math.Arithmetic.Division&quot;,&#10;&#9;&#9;n2,&#10;&#9;&#9;n5&#10;&#9;)&#10;);"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Note."/>
				</expression>
				<expression tag="String.Text" Value="For the definition of expressions it is not necessary to create expressions; the expression-creation code is shown because it will indeed be used in the following chapters."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Author: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Last modified:"/>
				<expression tag="Time.Time" Value="1781870400000"/>
			</expression>
		</expression>
	</expression>
</expression>