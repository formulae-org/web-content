<expression tag="Formulae.Script" Modules="org.formulae.typesetting,org.formulae.text.string,org.formulae.diagramming,org.formulae.visualization,org.formulae.internet,org.formulae.logic,org.formulae.time">
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Fōrmulæ. Guía del desarrollador"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Preparativos"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Antes de empezar a colaborar, deberás tener en tu equipo una copia del proyecto. En este apartado conocerás cómo está estructurado."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Estructura general"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Es necesario crear un directorio específico para el proyecto. El nombre no importa. Debajo de este directorio debe existir la siguiente estructura:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="raíz"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="formulae"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="lib"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="packages"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="org.formulae.math.arithmetic"/>
							</expression>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="org.formulae.logic"/>
							</expression>
						</expression>
						<expression tag="Visualization.HorizontalEllipsis"/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Italic" Value="True" Set="True">
								<expression tag="String.Text" Value="tu paquete"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="content"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="En el directorio raíz se deberán encontrar los siguientes archivos:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="El archivo"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="index.html"/>
					</expression>
					<expression tag="String.Text" Value="que contiene la página principal."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="El archivo"/>
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="formulae.css"/>
					</expression>
					<expression tag="String.Text" Value="que contiene los estilos básicos."/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="formulae"/>
				</expression>
				<expression tag="String.Text" Value="contiene la programación base. Contiene lo siguiente:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="Las clases base"/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="El código del"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="front-end"/>
					</expression>
					<expression tag="String.Text" Value="como"/>
					<expression tag="Typesetting.ItalicChunk">
						<expression tag="String.Text" Value="aplicación web"/>
					</expression>
					<expression tag="String.Text" Value="es decir, el programa que permite la visualización y edición de expresiones en un navegador web."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="String.Text" Value="El código del motor de reducción"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Si tú eres un programador que va a crear paquetes, el código de este directorio no es algo que modificarás, pero sí es necesario que exista para que puedas hacer tu trabajo."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="lib"/>
				</expression>
				<expression tag="String.Text" Value="contiene librerías que pueden ser utilizadas por el código base o paquetes. Por ahora, solamente la librería"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/MikeMcl/decimal.js" Description="decimal.js"/>
				<expression tag="String.Text" Value="es utilizada."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages."/>
				</expression>
				<expression tag="String.Text" Value="Recuerda que en Fōrmulæ la funcionalidad es modular, ya que se crea en unidades llamadas"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="paquetes."/>
				</expression>
				<expression tag="String.Text" Value="Cada paquete reside en su propio subdirectorio. Es importante hacer una lista de los paquetes que realmente necesitarás, no tiene caso descargar código que no utilizarás nunca o no tengas interés en probar. En este directorio crearás un subdirectorio para tu paquete."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="content"/>
				</expression>
				<expression tag="String.Text" Value="contiene archivos de tipo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value=".formulae"/>
				</expression>
				<expression tag="String.Text" Value="es decir, creados con Fōrmulæ, y contienen la base documental, conformada principalmente de ejemplos, referencia, tutoriales, artículos y guías de desarrollo. El archivo que estás viendo pertenece a esta última categoría. Si eres un programador que va a crear paquetes no es obligatorio que tengas todo el contenido, después de todo si quisieras acceder a él (por ejemplo ver las referencias o guías de usuario) puedes acceder a él a través del sitio web, tal y como lo haces con esta página."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Repositorios"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El repositorio para el código base"/>
				<expression tag="String.Text" Value="se encuentra en GitHub como"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org/formulae-js" Description="formulae-js"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="La librería"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/MikeMcl/decimal.js" Description="decimal.js"/>
				<expression tag="String.Text" Value="puede ser descargada"/>
				<expression tag="Internet.Hyperlink" Value="lib/decimal.min.js" Description="aquí."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Cada paquete tiene su propio repositorio en"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org#the-packages" Description="GitHub"/>
				<expression tag="String.Text" Value="No es necesario crear todos los directorios de los paquetes, aunque algunos son estrictamente indispensables, por ejemplo el de aritmética. La lista definitiva que usarás depende mucho de los paquetes en que desees contribuir."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El repositorio para el contenido se encuentra en"/>
				<expression tag="Internet.Hyperlink" Value="https://github.com/formulae-org/web-content" Description="web-content"/>
				<expression tag="String.Text" Value="sin embargo, no es estrictamente necesario que lo clones, a menos que vayas a participar también en la edición de contenido."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Estructura de un paquete"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Cada paquete, y por lo tanto el paquete que vas a crear, tiene una estructura como la siguiente:"/>
			</expression>
			<expression tag="Typesetting.Centering">
				<expression tag="Diagramming.Tree" Expanded="True">
					<expression tag="Visualization.Italic" Value="True" Set="True">
						<expression tag="String.Text" Value="paquete"/>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="expression.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="edition.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="reduction.js"/>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="i18n"/>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages.json"/>
							</expression>
						</expression>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages_es.json"/>
							</expression>
						</expression>
						<expression tag="String.Text" Value="..."/>
						<expression tag="Diagramming.Tree" Expanded="True">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="messages_it.json"/>
							</expression>
						</expression>
					</expression>
					<expression tag="Diagramming.Tree" Expanded="True">
						<expression tag="Visualization.HorizontalArray">
							<expression tag="Visualization.Code">
								<expression tag="String.Text" Value="img"/>
							</expression>
							<expression tag="String.Text" Value="(opcional)"/>
						</expression>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El archivo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="expression.js"/>
				</expression>
				<expression tag="String.Text" Value="contiene el código referido a la definición y visualización de expresiones, véase los apartados de"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Expressions" Description="definición"/>
				<expression tag="String.Text" Value="y"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Visualization" Description="visualización"/>
				<expression tag="String.Text" Value="de expresiones."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El archivo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="edition.js"/>
				</expression>
				<expression tag="String.Text" Value="contiene el código referido a la edición de expresiones, véase el apartado"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Edition" Description="edición de expresiones"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El archivo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="reduction.js"/>
				</expression>
				<expression tag="String.Text" Value="contiene el código referido a la transformación o reducción de expresiones, véase el apartado"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Reduction" Description="reducción de expresiones"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="i18n"/>
				</expression>
				<expression tag="String.Text" Value="es relativo a la internacionalización (acortada comúnmente como"/>
				<expression tag="Typesetting.ItalicChunk">
					<expression tag="String.Text" Value="i18n),"/>
				</expression>
				<expression tag="String.Text" Value="véase el apartado"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Internationalization" Description="internacionalización"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El directorio"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="img"/>
				</expression>
				<expression tag="String.Text" Value="es opcional, es utilizado para contener las imágenes requeridas por el módulo, básicamente como íconos, véase el apartado"/>
				<expression tag="Internet.Hyperlink" Value="/?script=collaboration/guides/package_developer/Edition" Description="edición de expresiones"/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Definición de paquetes a cargar, incluido el tuyo"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="En el directorio raíz se encuentra el archivo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages.json"/>
				</expression>
				<expression tag="String.Text" Value="el cual contiene un arreglo llamado"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="packages"/>
				</expression>
				<expression tag="String.Text" Value="en donde cada elemento describe un paquete conocido por el sistema. Por ejemplo:"/>
			</expression>
			<expression tag="Visualization.CodeBlock" Value="{ &quot;name&quot;: &quot;org.formulae.math.arithmetic&quot;, &quot;description&quot;: &quot;Arithmetic&quot;,            &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.algebra&quot;,         &quot;description&quot;: &quot;Algebra&quot;,               &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.math.complex&quot;,    &quot;description&quot;: &quot;Complex&quot;,               &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.relation&quot;,        &quot;description&quot;: &quot;Relation&quot;,              &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.logic&quot;,           &quot;description&quot;: &quot;Logic&quot;,                 &quot;required&quot;: true,  &quot;commonRequired&quot;: false },&#10;{ &quot;name&quot;: &quot;org.formulae.expression&quot;,      &quot;description&quot;: &quot;Expression management&quot;, &quot;required&quot;: true,  &quot;commonRequired&quot;: false }"/>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Cada objeto tiene los siguientes campos:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="name"/>
					</expression>
					<expression tag="String.Text" Value="el nombre del directorio del paquete."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="description"/>
					</expression>
					<expression tag="String.Text" Value="un nombre descriptivo del paquete."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="required"/>
					</expression>
					<expression tag="String.Text" Value="un valor booleano que indica si el paquete se debe cargar automáticamente. Se recomienda usar el valor"/>
					<expression tag="Logic.True"/>
					<expression tag="String.Text" Value="para que no lo tengas que recargar cada vez que hagas cambios en la programación."/>
				</expression>
				<expression tag="Typesetting.Paragraph">
					<expression tag="Visualization.Code">
						<expression tag="String.Text" Value="commonRequired"/>
					</expression>
					<expression tag="String.Text" Value="un valor booleano que indica si las clases que conforman el paquete deberán contar con una clase común. Para tu paquete, es mejor empezar utilizando un valor"/>
					<expression tag="Logic.False"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="De la lista completa de paquetes, para los que no son de tu interés, puedes cambiar su campo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="required"/>
				</expression>
				<expression tag="String.Text" Value="al valor"/>
				<expression tag="Logic.False"/>
				<expression tag="String.Text" Value="para que el framework no los cargue automáticamente."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Para el paquete que vas a crear, simplemente añade un nuevo objeto con su información al arreglo."/>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="Typesetting.BoldChunk">
					<expression tag="String.Text" Value="Ejecución"/>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El proyecto no se ejecuta simplemente invocando la página"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="index.html"/>
				</expression>
				<expression tag="String.Text" Value="ya que existe funcionalidad que exige que el proyecto se ejecute en un servidor web real, aunque sea localmente."/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Por lo anterior, es necesario utilizar alguno. No es requerido alguno en particular, se sugieren algunos de los siguientes:"/>
			</expression>
			<expression tag="Typesetting.BulletedList">
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Con"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Node.js"/>
						</expression>
						<expression tag="String.Text" Value="usar el paquete"/>
						<expression tag="Visualization.Code">
							<expression tag="String.Text" Value="http-server"/>
						</expression>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Instalar el paquete, posteriormente ubicarse en el directorio raíz y ejecutar:"/>
					</expression>
					<expression tag="Visualization.CodeBlock" Value="http-server"/>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="El puerto por defecto es el 8080"/>
					</expression>
				</expression>
				<expression tag="Typesetting.MultiParagraph">
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Con"/>
						<expression tag="Typesetting.BoldChunk">
							<expression tag="String.Text" Value="Python,"/>
						</expression>
						<expression tag="String.Text" Value="utilizar el módulo"/>
						<expression tag="Internet.Hyperlink" Value="https://docs.python.org/es/3.13/library/http.server.html" Description="http.server"/>
						<expression tag="String.Text" Value="el cual ya viene preinstalado."/>
					</expression>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="Para iniciar el servidor web, ubicarse en el directorio raíz y ejecutar:"/>
					</expression>
					<expression tag="Visualization.CodeBlock" Value="python3 -m http.server [puerto]"/>
					<expression tag="Typesetting.Paragraph">
						<expression tag="String.Text" Value="El puerto por defecto es el 8000"/>
					</expression>
				</expression>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Una vez que corre el servidor web, para invocar el sistema Fōrmulæ, en una pestaña de tu navegador, utilizar la URL:"/>
			</expression>
			<expression tag="Visualization.Code">
				<expression tag="String.Text" Value="localhost:&lt;puerto&gt;"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="El servidor web responderá con el contenido del archivo"/>
				<expression tag="Visualization.Code">
					<expression tag="String.Text" Value="index.html"/>
				</expression>
			</expression>
		</expression>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.Rule"/>
	</expression>
	<expression tag="Formulae.Script.Row" type="0">
		<expression tag="Typesetting.MultiParagraph">
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Autor: Laurence R. Ugalde"/>
			</expression>
			<expression tag="Typesetting.Paragraph">
				<expression tag="String.Text" Value="Fecha de última modificación:"/>
				<expression tag="Time.Time" Value="1781672329683"/>
			</expression>
		</expression>
	</expression>
</expression>